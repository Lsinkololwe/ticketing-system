# Buyer app (apps/ticketing). Server-only; nothing here is NEXT_PUBLIC_. No secrets in this file:
# put real values in .env.local or the deployment secret store.
APP_URL=http://localhost:3001
KEYCLOAK_ISSUER=http://localhost:8084/realms/myticketzm
# Optional: server-to-server base when it differs from the public issuer (containers).
# KEYCLOAK_INTERNAL_ISSUER=
KEYCLOAK_CLIENT_ID=myticketzm-web
# KEYCLOAK_CLIENT_SECRET=
# Resource audience required in the access token.
# API_AUDIENCE=
# Required in production. Noeviction or volatile-* policy (never allkeys-lru).
# REDIS_URL=redis://localhost:6379
# kid:base64(32 bytes)[,kid2:...]; the first key encrypts, all decrypt.
# BFF_ENC_KEYS=
# Proxies in front of the app that append to X-Forwarded-For (0 = do not trust it).
TRUST_PROXY_HOPS=0
GRAPHQL_URL=http://localhost:8080/graphql
# API_BASE_URL=
IDENTITY_BASE_URL=http://localhost:8081
# Service account with internal-write for /api/internal/auth/* and revocations.
# IDENTITY_CLIENT_ID=
# IDENTITY_CLIENT_SECRET=
TERMS_VERSION=2026-10
LOG_LEVEL=info
