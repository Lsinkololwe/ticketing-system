{
  "name": "@pml.tickets/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev:admin": "nx dev @pml.tickets/admin",
    "dev:ticketing": "nx dev @pml.tickets/ticketing",
    "dev:org-admin": "nx dev @pml.tickets/organization-admin",
    "build:admin": "nx build @pml.tickets/admin",
    "build:ticketing": "nx build @pml.tickets/ticketing",
    "build:org-admin": "nx build @pml.tickets/organization-admin",
    "build:all": "nx run-many -t build",
    "lint:all": "nx run-many -t lint",
    "typecheck:all": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:org-admin": "nx test organization-admin",
    "test:org-admin:watch": "nx test organization-admin --watch",
    "test:org-admin:coverage": "nx test organization-admin --coverage",
    "e2e": "TESTCONTAINERS_RYUK_DISABLED=true playwright test -c apps/admin/playwright.config.ts && TESTCONTAINERS_RYUK_DISABLED=true playwright test -c apps/organization-admin/playwright.config.ts && TESTCONTAINERS_RYUK_DISABLED=true playwright test -c apps/ticketing/playwright.config.ts",
    "e2e:org-admin": "playwright test -c apps/organization-admin/playwright.config.ts",
    "e2e:org-admin:headed": "playwright test -c apps/organization-admin/playwright.config.ts --headed",
    "e2e:org-admin:debug": "playwright test -c apps/organization-admin/playwright.config.ts --debug",
    "e2e:compliance": "TESTCONTAINERS_RYUK_DISABLED=true playwright test -c apps/admin/playwright.config.ts --project=public && TESTCONTAINERS_RYUK_DISABLED=true playwright test -c apps/organization-admin/playwright.config.ts --project=public && TESTCONTAINERS_RYUK_DISABLED=true playwright test -c apps/ticketing/playwright.config.ts brand.spec.ts",
    "e2e:compliance:headed": "TESTCONTAINERS_RYUK_DISABLED=true playwright test -c apps/admin/playwright.config.ts --project=public --headed && TESTCONTAINERS_RYUK_DISABLED=true playwright test -c apps/organization-admin/playwright.config.ts --project=public --headed && TESTCONTAINERS_RYUK_DISABLED=true playwright test -c apps/ticketing/playwright.config.ts brand.spec.ts --headed",
    "compliance:all": "pnpm lint:all && pnpm e2e:compliance",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:compose": "(cd ../../../docker-resources/apollo-router/ticketing && ./compose-supergraph.sh --static) && npm run codegen",
    "codegen:local": "bash scripts/codegen-local.sh",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "supergraph:update": "cd ../../docker-resources/apollo-router && ./update-supergraph.sh",
    "supergraph:compose": "cd ../../docker-resources/apollo-router && rover supergraph compose --config supergraph.yaml --output supergraph.graphql",
    "test:shared": "vitest run --config libs/shared/vitest.config.ts",
    "test:shared:watch": "vitest --config libs/shared/vitest.config.ts"
  },
  "private": true,
  "dependencies": {
    "@apollo/client": "^4.0.7",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-query-devtools": "^5.60.0",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "formik": "^2.4.6",
    "graphql": "^16.11.0",
    "graphql-request": "^6.1.0",
    "ioredis": "^5.4.1",
    "jose": "^6.2.3",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.13.7",
    "mongodb": "^7.2.0",
    "next": "^16.2.11",
    "next-devtools-mcp": "^0.3.10",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.79.0",
    "react-phone-number-input": "^3.4.17",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "yup": "^1.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typed-document-node": "^5.0.6",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-operations": "^4.2.0",
    "@graphql-tools/mock": "^9.1.7",
    "@microcks/microcks-testcontainers": "^0.3.5",
    "@mswjs/data": "^0.16.2",
    "@nx/devkit": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/next": "23.1.0",
    "@nx/playwright": "23.1.0",
    "@nx/react": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yup": "^0.29.14",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "10.4.13",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.0.0",
    "happy-dom": "^20.10.1",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "nx": "23.1.0",
    "postcss": "8.4.38",
    "postcss-selector-parser": "^7.1.1",
    "tailwindcss": "3.4.3",
    "testcontainers": "^12.1.0",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.8"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "overrides": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
