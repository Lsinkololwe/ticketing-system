{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Payment Attempt Schema",
    "description": "MongoDB JSON Schema for booking_payment_attempts \u2014 one row per collect attempt against the mobile-money provider, staged before the call is made (ET-PAY-001).",
    "required": [
      "depositId",
      "amount",
      "currency",
      "status",
      "createdAt"
    ],
    "properties": {
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes \u2014 silently in tests, which use a template with no validator, and totally in production."
      },
      "_id": {
        "bsonType": "objectId"
      },
      "depositId": {
        "bsonType": "string",
        "description": "UUID sent to the provider as its deposit id \u2014 the idempotency key, unique"
      },
      "paymentIntentId": {
        "bsonType": [
          "string",
          "null"
        ],
        "description": "ET-PAY-001 \u00a74 \u00b7 the PaymentIntent this attempt was made for; answers paymentAttempts(intentId)"
      },
      "attemptNumber": {
        "bsonType": [
          "string",
          "null"
        ],
        "description": "Human-readable attempt number, format PAY-{YYYYMMDD}-{XXXXX}"
      },
      "correlationId": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "reservationId": {
        "bsonType": "string"
      },
      "eventId": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "organizerId": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "organizationId": {
        "bsonType": [
          "string",
          "null"
        ],
        "description": "OWASP A01 \u00b7 tenant isolation"
      },
      "buyerId": {
        "bsonType": "string"
      },
      "clientReferenceId": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "amount": {
        "bsonType": "decimal",
        "minimum": 0
      },
      "currency": {
        "bsonType": "string"
      },
      "provider": {
        "bsonType": [
          "string",
          "null"
        ],
        "description": "Mobile-money provider code, e.g. MTN_MOMO_ZMB"
      },
      "payerPhone": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "customerMessage": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "status": {
        "enum": [
          "CREATED",
          "PENDING_APPROVAL",
          "PROCESSING",
          "CONFIRMED",
          "COMPLETED",
          "FAILED",
          "REJECTED",
          "EXPIRED",
          "CANCELLED"
        ]
      },
      "providerStatus": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "providerTransactionId": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "country": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "failureCode": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "failureMessage": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "customerErrorMessage": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "apiCalledAt": {
        "bsonType": [
          "date",
          "null"
        ]
      },
