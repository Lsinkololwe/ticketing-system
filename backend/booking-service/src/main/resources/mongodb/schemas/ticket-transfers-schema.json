          "ACCEPTED",
          "DECLINED",
          "CANCELLED",
          "EXPIRED"
        ]
      },
      "expiresAt": {
        "bsonType": "date"
      },
      "resolvedAt": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "resolvedBy": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "createdAt": {
        "bsonType": [
          "date",
