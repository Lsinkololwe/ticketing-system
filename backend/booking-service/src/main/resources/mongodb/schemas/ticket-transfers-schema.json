        "description": "Spring Data's type hint, written on every document by the mapping converter"
      },
      "_id": {
        "bsonType": [
          "string",
          "objectId"
        ],
        "description": "A transfer is keyed by the id its workflow was started under, a UUID"
      },
      "version": {
        "bsonType": [
          "long",
          "int",
          "null"
        ]
      },
      "ticketId": {
        "bsonType": "string",
        "minLength": 1
      },
      "ticketNumber": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "bookingId": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "bookingNumber": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "eventId": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "eventTitle": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "organizationId": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "fromUserId": {
        "bsonType": "string",
        "minLength": 1
      },
      "fromDisplayName": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 100
      },
      "toUserId": {
        "bsonType": "string",
        "minLength": 1
      },
      "toDisplayName": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 100
      },
      "recipientChannel": {
        "bsonType": [
          "string",
