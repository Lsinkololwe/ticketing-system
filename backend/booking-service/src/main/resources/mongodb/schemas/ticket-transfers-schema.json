{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Ticket Transfers Schema",
    "description": "One offer of one ticket from its holder to another registered user. Holds a masked rendering of the recipient's contact, never the contact. At most one open offer per ticket (see the index registry).",
