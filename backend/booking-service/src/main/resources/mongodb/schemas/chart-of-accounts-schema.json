{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Chart of Accounts Schema - OWASP Compliant",
    "description": "Foundation for double-entry bookkeeping with hierarchical account structure",
    "required": [
      "accountCode",
      "accountName",
      "accountType",
      "currency",
      "isActive",
      "createdAt"
    ],
    "properties": {
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes \u2014 silently in tests, which use a template with no validator, and totally in production."
      },
      "_id": {
        "bsonType": "objectId"
      },
      "accountCode": {
        "bsonType": "string",
        "pattern": "^\\d{4}(-[A-Za-z0-9]+)?$",
        "description": "OWASP A03 - Account code format (e.g., 1021, 2010-0001)"
      },
      "accountName": {
        "bsonType": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "accountType": {
        "bsonType": "string",
        "enum": [
          "ASSET",
          "LIABILITY",
          "EQUITY",
          "REVENUE",
          "EXPENSE"
        ],
        "description": "OWASP A04 - Enum constraint for account type"
      },
      "subType": {
        "bsonType": [
          "string",
          "null"
        ],
        "enum": [
          "BANK_ACCOUNT",
          "RECEIVABLE",
          "ESCROW_PAYABLE",
          "COMMISSION_REVENUE",
          "GATEWAY_FEE",
          "GATEWAY_RECEIVABLE",
          "COMMISSION_RECEIVABLE",
          "CHARGEBACK_RECOVERY_RECEIVABLE",
          "CHARGEBACK_RECEIVABLE",
          "PAYOUT_PAYABLE",
          "REFUND_PAYABLE",
          "TAX_PAYABLE",
          "FEES_PAYABLE",
          "DEFERRED_REVENUE",
          "PAYOUTS_PAYABLE",
          "REFUNDS_PAYABLE",
          "RETAINED_EARNINGS",
          "RESERVE",
          "FEE_REVENUE",
          "OTHER_INCOME",
          "GATEWAY_FEE_EXPENSE",
          "CHARGEBACK_EXPENSE",
          "CHARGEBACK_LOSS",
          "CHARGEBACK_FEES",
          "GATEWAY_FEES",
          "BAD_DEBT_EXPENSE",
          "BAD_DEBT",
          "VERIFICATION_EXPENSE",
          "OTHER_EXPENSE",
          null
        ]
      },
      "parentAccountCode": {
        "bsonType": [
          "string",
          "null"
        ],
        "pattern": "^\\d{4}$",
        "description": "Parent account for hierarchical structure"
      },
      "currency": {
        "bsonType": "string",
        "enum": [
          "ZMW",
          "USD"
        ],
        "description": "OWASP A04 - Enum constraint"
      },
      "isActive": {
        "bsonType": "bool"
      },
      "description": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 1000
      },
      "createdAt": {
        "bsonType": "date"
      },
      "updatedAt": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "version": {
        "bsonType": [
          "long",
          "null"
        ]
      }
    },
    "additionalProperties": false
  }
}
