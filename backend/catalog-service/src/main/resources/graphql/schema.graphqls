type EventCancellationResponse {
    event: Event
    ticketsAffected: Int!
    refundSagaInitiated: Boolean!
    sagaId: ID
}

# Shared type - must have @shareable on all fields for federation
type BulkApprovalResponse {
    processedCount: Int!
    failedCount: Int!
    results: [EventApprovalResult!]!
}

type EventApprovalResult {
    eventId: ID!
    eventTitle: String
    "Null when this event was approved. Otherwise the ET-PLT-005 registry code explaining why it was not."
    errorCode: String
    newStatus: EventStatus
}

type BulkReminderResponse {
    sentCount: Int!
    failedCount: Int!
}

# ============================================================================
# SECTION 13: ROOT QUERY TYPE
# ============================================================================
#
# Queries are tagged by their intended audience:
# - (no tag) = Public - available to all clients (mobile, web, admin)
# - "mobile" = Mobile app specific features
# - "organizer" = Organizer dashboard features
# - "admin" = Platform administrator features only
# - "internal" = Service-to-service communication only
#
type Query {
    # ========================================================================
    # EVENT DISCOVERY QUERIES (PUBLIC - For all consumers)
    # ========================================================================
    # These queries are used by mobile apps and web to browse/search events.
    # No tags needed - available to all clients.

    # ── Reference data · bounded public lists (ET-CAT-003 §4, O-1(a)) ──────
    # Zambia has ten provinces, roughly two hundred cities and fifteen categories.
    # §4 declares all three as bounded PUBLIC lists and never asked for them to be
    # paged; the *OffsetPagination / *CursorPagination variants below are deprecated
    # in favour of these. Bounded by the data, not by a page size the client picks.
    provinces: [Province!]! @auth(requires: PUBLIC)
    cities(provinceId: String): [City!]! @auth(requires: PUBLIC)
    categories: [EventCategory!]! @auth(requires: PUBLIC)

    # Get single event by ID - PUBLIC
    # F-007 · "PUBLIC" here means published. A caller with no token reaches this block only
    # through PublicDiscoveryConfig's allowlist (ET-CAT-004-R13); everything else needs a
    # token. The resolver
    # applies the same published+active filter the list queries below carry, and
    # answers null for a draft, a rejected event or a soft-deleted one unless the
    # caller's organization owns it.
    event(id: ID!): Event @auth(requires: PUBLIC)

    # Combined discovery with all filters - PRIMARY PUBLIC QUERY
    # This is the main query for event discovery on mobile and web
    discoverEvents(filter: EventDiscoveryFilterInput!, pagination: CursorPaginationInput, sort: EventDiscoverySort = SOONEST): EventConnection! @auth(requires: PUBLIC)

    # Cursor pagination queries (mobile/infinite scroll) - PUBLIC
    # Used by mobile apps for infinite scroll event lists
    searchEvents(query: String!, pagination: CursorPaginationInput): EventConnection! @auth(requires: PUBLIC)
    eventsByCategory(categoryId: String!, pagination: CursorPaginationInput): EventConnection! @auth(requires: PUBLIC)
    eventsByCity(city: String!, pagination: CursorPaginationInput): EventConnection! @auth(requires: PUBLIC)

    # ========================================================================
    # ORGANIZER SELF-SERVICE EVENT QUERIES
    # These queries extract organizerId from JWT (OWASP A01:2021 compliance)
    # ========================================================================

    # Get current organizer's events with offset pagination
    myEvents(filter: OrganizerEventFilterInput, pagination: OffsetPaginationInput): EventOffsetPage! @auth(requires: ORGANIZER) @tag(name: "organizer")

    # Get current organizer's draft events
    myDraftEvents(pagination: OffsetPaginationInput): EventOffsetPage! @auth(requires: ORGANIZER) @tag(name: "organizer")

    # Get current organizer's event count
    myEventCount: Int! @auth(requires: ORGANIZER) @tag(name: "organizer")

    # Get current organizer's event count by status
    myEventCountByStatus(status: EventStatus!): Int! @auth(requires: ORGANIZER) @tag(name: "organizer")

    # ========================================================================
    # EVENT COUNT QUERIES (ADMIN - Dashboard statistics)
    # ========================================================================
    # Count queries for admin dashboard statistics cards

    eventCount: Int! @auth(requires: ADMIN) @tag(name: "admin")
    eventCountByOrganizer(organizerId: String!): Int! @auth(requires: ORGANIZER) @tag(name: "organizer")
    eventCountByCategory(categoryId: String!): Int! @auth(requires: ADMIN) @tag(name: "admin")
    eventCountByCity(city: String!): Int! @auth(requires: ADMIN) @tag(name: "admin")
    eventCountByStatus(status: EventStatus!): Int! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # EVENT STATISTICS QUERIES (ORGANIZER/ADMIN)
    # ========================================================================
    # Per-event statistics - organizers can see their own event stats

    # Per-event ticket statistics - for organizer dashboard
    eventStatistics(eventId: ID!): EventTicketStatistics @auth(requires: ORGANIZER) @tag(name: "organizer")
    ticketTierStatistics(eventId: ID!, tierId: ID!): TicketTierStats @auth(requires: ORGANIZER) @tag(name: "organizer")

    # Platform-wide event statistics - ADMIN ONLY
    eventStats: EventStats! @auth(requires: ADMIN) @tag(name: "admin")

    # ADMIN - Catalog-owned pending approval-queue counts for the action-center
    # sidebar badges. One of three federated root fields (identity/catalog/booking)
    # the Apollo Router composes into the frontend's single PendingCounts query.
    catalogPendingCounts: CatalogPendingCounts! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # ADMIN EVENT MANAGEMENT QUERIES
    # ========================================================================
    # These queries are for managing events - approval workflow, drafts, etc.

    # General event list with filters - ADMIN dashboard
    events(filter: EventFilterInput, pagination: OffsetPaginationInput): EventOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")

    # Draft events - Organizer sees their own, admin sees all
    draftEvents(organizerId: String!, pagination: OffsetPaginationInput): EventOffsetPage! @auth(requires: ORGANIZER) @tag(name: "organizer")

    # Approval workflow queries - ADMIN ONLY
    pendingApprovalEvents(pagination: OffsetPaginationInput): EventOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")
    overdueApprovalEvents(pagination: OffsetPaginationInput): EventOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")
    approvedNotPublishedEvents(pagination: OffsetPaginationInput): EventOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")
    eventsByStatus(status: EventStatus!, pagination: OffsetPaginationInput): EventOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")
    cancelledEvents(pagination: OffsetPaginationInput): EventOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")
    completedEvents(pagination: OffsetPaginationInput): EventOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # LOCATION QUERIES
    # ========================================================================

    location(id: ID!): Location @auth(requires: PUBLIC)

    # Cursor pagination (mobile/infinite scroll)
    locations(pagination: CursorPaginationInput): LocationConnection! @auth(requires: PUBLIC)
    locationsByCity(city: String!, pagination: CursorPaginationInput): LocationConnection! @auth(requires: PUBLIC)
    locationsByCountry(country: String!, pagination: CursorPaginationInput): LocationConnection! @auth(requires: PUBLIC)
    # PUBLIC - Mobile search with cursor pagination for infinite scroll
    searchLocations(query: String!, pagination: CursorPaginationInput): LocationConnection! @auth(requires: PUBLIC)
    # PUBLIC - Mobile nearby locations with cursor pagination
    locationsNearby(input: NearbyLocationInput!, pagination: CursorPaginationInput): LocationConnection! @auth(requires: PUBLIC)

    # ========================================================================
    # CITY QUERIES
    # Cities are reference data used for filtering - public for event discovery
    # ========================================================================

    # PUBLIC - Single city lookup for event location display
    city(id: ID!): City @auth(requires: PUBLIC)

    # PUBLIC - Used for filtering events to cities that have events
    citiesWithEvents: [City!]! @auth(requires: PUBLIC)

    # ========================================================================
    # PROVINCE QUERIES
    # Provinces are reference data used for regional filtering - public for discovery
    # ========================================================================

    # PUBLIC - Single province lookup for regional display
    province(id: ID!): Province @auth(requires: PUBLIC)

    # ========================================================================
    # EVENT CATEGORY QUERIES
    # Categories are essential for event discovery - public for filtering
    # ========================================================================

    # PUBLIC - Single category lookup for event categorization display
    eventCategory(id: ID!): EventCategory @auth(requires: PUBLIC)

    # PUBLIC - Popular categories for mobile home screen and event discovery
    popularCategories(limit: Int = 10): [EventCategory!]! @auth(requires: PUBLIC)

    # ========================================================================
    # PLATFORM CONFIGURATION QUERIES (Admin Only)
    # Platform settings for SLA, escalation, and notification configuration
    # ========================================================================

    # ADMIN - Get current platform configuration
    platformConfiguration: PlatformConfiguration! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # APPROVAL TIMELINE QUERIES
    # Approval workflows are admin-only - platform administrators manage event approvals
    # Organizers can see their own approval status via event.status field
    # ========================================================================

    # ADMIN - View approval timeline for any event (approval workflow visibility)
    approvalTimeline(eventId: String!): ApprovalTimeline @auth(requires: ADMIN) @tag(name: "admin")

    # ---------------------------------------------------------------------------
    # ADMIN APPROVAL QUERIES - Offset pagination for admin dashboard tables
    # Approval workflow management is admin-only functionality
    # ---------------------------------------------------------------------------
    approvalTimelines(filter: ApprovalTimelineFilterInput, pagination: OffsetPaginationInput): ApprovalTimelineOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")
    approvalTimelinesByOrganizer(organizerId: String!, pagination: OffsetPaginationInput): ApprovalTimelineOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")
    pendingApprovalTimelines(pagination: OffsetPaginationInput): ApprovalTimelineOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")
    overdueApprovalTimelines(pagination: OffsetPaginationInput): ApprovalTimelineOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # APPROVAL ESCALATION QUERIES (Admin Only)
    # ========================================================================

    # ADMIN - Get specific escalation by ID
    approvalEscalation(id: ID!): ApprovalEscalation @auth(requires: ADMIN) @tag(name: "admin")

    # ADMIN - Get active escalations (offset pagination for dashboard)
    activeEscalations(pagination: OffsetPaginationInput): ApprovalEscalationOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")

    # ADMIN - Get escalations assigned to current admin (adminId from JWT - OWASP A01:2021)
    myEscalations(pagination: OffsetPaginationInput): ApprovalEscalationOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # APPROVAL STATISTICS QUERIES (Admin Only)
    # ========================================================================

    # ADMIN - Get approval workflow statistics for dashboard
    approvalStats: ApprovalStats! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # TICKET TIER QUERIES
    # Ticket tiers are essential for the ticket purchase flow
    # PUBLIC - Needed by mobile app for displaying ticket options
    # ========================================================================

    # PUBLIC - Single ticket tier lookup for purchase flow
    ticketTier(id: ID!): TicketTier @auth(requires: PUBLIC)
    # ORGANIZER/ADMIN - Include hidden tiers (draft tiers not visible to customers)
    # Organizers need to see all tiers including hidden ones when managing events
    eventTicketTiers(eventId: ID!, includeHidden: Boolean = false): [TicketTier!]! @auth(requires: ORGANIZER) @tag(name: "organizer")
    # PUBLIC - Available tiers for customer ticket purchase (mobile app)
    availableTicketTiers(eventId: ID!): [TicketTier!]! @auth(requires: PUBLIC)

    # ========================================================================
    # EVENT LIFECYCLE QUERIES
    # Lifecycle management is for event management (organizers and admins)
    # Customers don't need to see internal lifecycle/status transition logic
    # ========================================================================

    # ORGANIZER/ADMIN - View event lifecycle state and history
    eventLifecycle(eventId: String!): EventLifecycle @auth(requires: ORGANIZER) @tag(name: "organizer")
    # ORGANIZER/ADMIN - Determine valid status transitions for workflow UI
    allowedStatusTransitions(eventId: String!): [EventStatus!]! @auth(requires: ORGANIZER) @tag(name: "organizer")

    # ========================================================================
    # EXPORT QUERIES
    # Export functionality is admin-only for platform reporting
    # Organizers get their own reporting via separate organizer dashboard queries
    # ========================================================================

    # ADMIN - Export single event data for compliance/reporting
    exportEventData(eventId: ID!, format: ExportFormat!): ReportExport! @auth(requires: ADMIN) @tag(name: "admin")
    # ADMIN - Export filtered events report for platform analytics
    exportEventsReport(filter: EventFilterInput!, format: ExportFormat!): ReportExport! @auth(requires: ADMIN) @tag(name: "admin")
}

# ============================================================================
# SECTION 14: ROOT MUTATION TYPE
# Tags indicate which clients should include these mutations in their operations:
# - organizer: Organizer dashboard for event management
# - admin: Platform administrator operations
# - mobile: Consumer mobile app actions
# ============================================================================
type Mutation {
    # ========================================================================
    # EVENT MUTATIONS
    # Organizers create and manage their own events
    # Admin can also perform these operations for platform management
    # ========================================================================

    # ORGANIZER - Core event CRUD operations
    # NOTE: organizerId is extracted from JWT authentication, not passed as parameter
    # This prevents OWASP A01:2021 Broken Access Control vulnerabilities
    createEvent(input: CreateEventInput!): Event! @auth(requires: ORGANIZER) @tag(name: "organizer")
    updateEvent(id: ID!, input: UpdateEventInput!): Event! @auth(requires: ORGANIZER) @tag(name: "organizer")
    deleteEvent(id: ID!): ID! @auth(requires: ORGANIZER) @tag(name: "organizer")
    # ORGANIZER - Event publishing workflow
    publishEvent(id: ID!): Event! @auth(requires: ORGANIZER) @tag(name: "organizer")
    unpublishEvent(id: ID!): Event! @auth(requires: ORGANIZER) @tag(name: "organizer")
    rescheduleEvent(input: RescheduleEventInput!): Event! @auth(requires: ORGANIZER) @tag(name: "organizer")
    # ORGANIZER - Event cancellation (triggers refund workflows)
    cancelEvent(id: ID!, input: EventCancellationInput!): EventCancellationResponse! @auth(requires: ORGANIZER) @tag(name: "organizer") @tag(name: "admin")
    # INTERNAL - Auto-completion triggered by system when event date passes
    completeEvent(id: ID!): Event! @auth(requires: INTERNAL) @tag(name: "internal")
    # ORGANIZER - Duplicate event for recurring events workflow
    duplicateEvent(eventId: ID!, newTitle: String!): Event! @auth(requires: ORGANIZER) @tag(name: "organizer")
    # ORGANIZER - Capacity and accessibility management
    updateEventCapacity(eventId: ID!, newCapacity: Int!): Event! @auth(requires: ORGANIZER) @tag(name: "organizer")
    updateEventAccessibility(eventId: ID!, input: EventAccessibilityInput!): Event! @auth(requires: ORGANIZER) @tag(name: "organizer")
    # ADMIN - Featured events are platform decisions (homepage promotion)
    featureEvent(eventId: ID!, featured: Boolean!): Event! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # PLATFORM CONFIGURATION MUTATIONS (Admin Only)
    # ========================================================================

    # ADMIN - Update platform configuration (SLA settings, escalation, notifications)
    updatePlatformConfiguration(input: UpdatePlatformConfigurationInput!): PlatformConfiguration! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # EVENT APPROVAL MUTATIONS
    # Approval workflow: Organizers submit, Admins approve/reject
    # ========================================================================

    # ORGANIZER - Submit event for platform review
    # NOTE: organizerId is extracted from JWT authentication
    submitEventForApproval(eventId: ID!): Event! @auth(requires: ORGANIZER) @tag(name: "organizer")
    # ADMIN - Approval decisions are admin-only platform operations
    # NOTE: reviewerId/adminId extracted from JWT authentication (OWASP A01:2021 compliance)
    approveEvent(eventId: ID!, comments: String): Event! @auth(requires: ADMIN) @tag(name: "admin")
    rejectEvent(eventId: ID!, comments: String!): Event! @auth(requires: ADMIN) @tag(name: "admin")
    requestEventChanges(eventId: ID!, comments: String!): Event! @auth(requires: ADMIN) @tag(name: "admin")

    # ADMIN - Reviewer assignment for approval workflow
    assignEventReviewer(input: AssignReviewerInput!): ApprovalTimeline! @auth(requires: ADMIN) @tag(name: "admin")
    unassignEventReviewer(eventId: ID!, reason: String): ApprovalTimeline! @auth(requires: ADMIN) @tag(name: "admin")

    # ADMIN - Add internal comment to approval timeline (without status change)
    # NOTE: adminId extracted from JWT authentication (OWASP A01:2021 compliance)
    addApprovalComment(eventId: ID!, comment: String!, isInternal: Boolean = true): ApprovalTimeline! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # ESCALATION MUTATIONS (Admin Only)
    # NOTE: All adminId parameters extracted from JWT authentication (OWASP A01:2021 compliance)
    # ========================================================================

    # ADMIN - Acknowledge an escalation
    acknowledgeEscalation(escalationId: ID!, notes: String): ApprovalEscalation! @auth(requires: ADMIN) @tag(name: "admin")

    # ADMIN - Resolve an escalation (must also approve/reject/request changes)
    resolveEscalation(input: ResolveEscalationInput!): ApprovalEscalation! @auth(requires: ADMIN) @tag(name: "admin")

    # ADMIN - Manually trigger escalation (for testing or manual override)
    triggerManualEscalation(eventId: ID!, reason: String!, escalateTo: String!): ApprovalEscalation! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # EVENT REMINDER MUTATIONS
    # Platform sends reminders to organizers - admin operation
    # ========================================================================

    # ADMIN - Platform nudges organizers to publish their events
    sendEventPublishReminder(eventId: ID!, triggeredBy: String!): Event! @auth(requires: ADMIN) @tag(name: "admin")
    sendBulkEventPublishReminders(eventIds: [ID!]!, triggeredBy: String!): BulkReminderResponse! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # TICKET TIER MUTATIONS
    # Organizers manage ticket tiers for their events
    # ========================================================================

    # ORGANIZER - Ticket tier CRUD for event pricing structure
    createTicketTier(eventId: ID!, input: CreateTicketTierInput!): TicketTier! @auth(requires: ORGANIZER) @tag(name: "organizer")
    updateTicketTier(tierId: ID!, input: UpdateTicketTierInput!): TicketTier! @auth(requires: ORGANIZER) @tag(name: "organizer")
    deleteTicketTier(tierId: ID!): ID! @auth(requires: ORGANIZER) @tag(name: "organizer")
    reorderTicketTiers(eventId: ID!, tierIds: [ID!]!): [TicketTier!]! @auth(requires: ORGANIZER) @tag(name: "organizer")
    activateTicketTier(tierId: ID!): TicketTier! @auth(requires: ORGANIZER) @tag(name: "organizer")
    deactivateTicketTier(tierId: ID!): TicketTier! @auth(requires: ORGANIZER) @tag(name: "organizer")

    # ========================================================================
    # EVENT CATEGORY MUTATIONS
    # Platform manages category reference data - admin only
    # ========================================================================

    # ADMIN - Category CRUD for platform taxonomy
    createEventCategory(input: CreateEventCategoryInput!): EventCategory! @auth(requires: ADMIN) @tag(name: "admin")
    updateEventCategory(id: ID!, input: UpdateEventCategoryInput!): EventCategory! @auth(requires: ADMIN) @tag(name: "admin")
    deleteEventCategory(id: ID!): ID! @auth(requires: ADMIN) @tag(name: "admin")
    activateEventCategory(id: ID!): EventCategory! @auth(requires: ADMIN) @tag(name: "admin")
    deactivateEventCategory(id: ID!): EventCategory! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # PROVINCE MUTATIONS
    # Platform manages province reference data - admin only
    # ========================================================================

    # ADMIN - Province CRUD for regional data management
    createProvince(input: CreateProvinceInput!): Province! @auth(requires: ADMIN) @tag(name: "admin")
    updateProvince(id: ID!, input: UpdateProvinceInput!): Province! @auth(requires: ADMIN) @tag(name: "admin")
    deleteProvince(id: ID!): ID! @auth(requires: ADMIN) @tag(name: "admin")

    # ========================================================================
    # CITY MUTATIONS
    # Platform manages city reference data - admin only
    # ========================================================================

    # ADMIN - City CRUD for geographic reference data
    createCity(input: CreateCityInput!): City! @auth(requires: ADMIN) @tag(name: "admin")
    updateCity(id: ID!, input: UpdateCityInput!): City! @auth(requires: ADMIN) @tag(name: "admin")
    deleteCity(id: ID!): ID! @auth(requires: ADMIN) @tag(name: "admin")
}

# ============================================================================
# SECTION: REFERENCE DATA (polymorphic lookup / catalog store)
# One collection, one CRUD surface for every business-editable list.
# Reads are public (storefront dropdowns); writes are admin-only.
# ============================================================================

"""Discriminator for the polymorphic reference_data collection. Adding a value is a backend change."""
enum ReferenceType {
    COUNTRY
    CURRENCY
    LANGUAGE
    TIMEZONE
    PROVINCE
    CITY
    MOBILE_MONEY_OPERATOR
    BANK
    EVENT_TYPE
    EVENT_CATEGORY
    MUSIC_GENRE
    AGE_RESTRICTION
    TICKET_TIER_CATEGORY
    KYB_DOCUMENT_TYPE
    ORGANIZER_TYPE
    BUSINESS_TYPE
    ORGANIZATION_ROLE
    EVENT_ROLE
    NOTIFICATION_CHANNEL
    NOTIFICATION_CATEGORY
    REPORT_PERIOD
    CANCELLATION_REASON
    REFUND_REASON
    REJECTION_REASON
    TAX_RATE
    CARD_SCHEME
    # Workflow statuses. Configurable exactly like everything above — an admin
    # adds "AWAITING_COMPLIANCE_REVIEW" to PAYOUT_STATUS with no deployment.
    # The difference is that these DRIVE BEHAVIOUR, so every row must declare a
    # semantic and code branches on that, never on the code string.
    TICKET_STATUS
    PAYMENT_STATUS
    PAYOUT_STATUS
    REFUND_STATUS
    CHARGEBACK_STATUS
    ESCROW_STATUS
    EVENT_STATUS
    ORGANIZATION_STATUS
    VERIFICATION_DOCUMENT_STATUS
    TEAM_INVITATION_STATUS
    RESERVATION_STATUS
}

"""
What an administrator-defined status MEANS to the code.

Statuses are fully configurable, but code cannot branch on a string somebody
invented this morning — a payout in an unrecognised status never moves, and
nobody finds out until an organizer asks where the money went. So the value SET
is configurable and this small vocabulary of meanings is fixed. Same shape as
Jira's status categories, for the same reason.
"""
enum WorkflowSemantic {
    INITIAL
    PENDING
    IN_PROGRESS
    SUCCEEDED
    FAILED
    CANCELLED
}

"""A single reference/catalog row."""
type ReferenceData {
    id: ID!
    type: ReferenceType!
    code: String!
    name: String!
    description: String
    # Required for workflow types, null for taxonomy. Branches read THIS, never
    # `code`, which is what lets an administrator add a status without a deploy.
    semantic: WorkflowSemantic
    # Codes this value may move to. Empty means unconstrained — populating it
    # makes the workflow itself configurable, not just its vocabulary.
    allowedTransitions: [String!]!
    parentType: ReferenceType
    parentCode: String
    displayOrder: Int!
    isActive: Boolean!
    isSystem: Boolean!
    effectiveFrom: DateTime
    effectiveTo: DateTime
    metadata: JSON
    createdAt: DateTime
    updatedAt: DateTime
    createdBy: String
    updatedBy: String
}

"""Describes a ReferenceType for the admin type picker (label, group, metadata form fields)."""
type ReferenceTypeInfo {
    type: ReferenceType!
    label: String!
    group: String!
    groupLabel: String!
    requiredMetadataKeys: [String!]!
}

type ReferenceDataOffsetPage {
    content: [ReferenceData!]!
    pageNumber: Int!
    pageSize: Int!
    totalElements: Int!
    totalPages: Int!
    hasNext: Boolean!
    hasPrevious: Boolean!
}

input CreateReferenceDataInput {
    # Required when type is a workflow type; meaningless otherwise.
    semantic: WorkflowSemantic
    allowedTransitions: [String!]
    type: ReferenceType!
    code: String!
    name: String!
    description: String
    parentType: ReferenceType
    parentCode: String
    displayOrder: Int
    isActive: Boolean
    metadata: JSON
}

input UpdateReferenceDataInput {
    # Required when type is a workflow type; meaningless otherwise.
    semantic: WorkflowSemantic
    # Refused for types whose transitions are owned by a state machine in code
    # (TICKET_STATUS, RESERVATION_STATUS, EVENT_STATUS) — editing them there
    # would appear to work and change nothing.
    allowedTransitions: [String!]
    name: String
    description: String
    parentType: ReferenceType
    parentCode: String
    displayOrder: Int
    isActive: Boolean
    metadata: JSON
    effectiveFrom: DateTime
    effectiveTo: DateTime
}

extend type Query {
    """A single reference item by type + code."""
    referenceItem(type: ReferenceType!, code: String!): ReferenceData @auth(requires: PUBLIC)

    """All rows of a type. activeOnly=true (default) is the dropdown query."""
    referenceData(type: ReferenceType!, activeOnly: Boolean = true): [ReferenceData!]!

    """Child rows within a hierarchy (active only), e.g. genres of a category."""
    referenceDataByParent(type: ReferenceType!, parentCode: String!): [ReferenceData!]!

    """The type registry that powers the generic admin management screen."""
    referenceTypes: [ReferenceTypeInfo!]! @auth(requires: PUBLIC)

    """
    All rows of a type including inactive ones, paged — the admin management table.

    O-5 · this is ET-PLT-014 §4's `referenceDataAll`, and adopting that name resolves the
    collision that held it back from D-19's de-suffixing: `referenceData` above already
    exists as the bounded dropdown query, so the suffix could not simply be dropped. The
    two are different operations, not two spellings of one — `referenceData` is public and
    active-only, this is admin and shows everything.
    """
    referenceDataAll(type: ReferenceType!, pagination: OffsetPaginationInput): ReferenceDataOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")
}

extend type Mutation {
    createReferenceData(input: CreateReferenceDataInput!): ReferenceData! @auth(requires: ADMIN) @tag(name: "admin")
    updateReferenceData(id: ID!, input: UpdateReferenceDataInput!): ReferenceData! @auth(requires: ADMIN) @tag(name: "admin")
    deleteReferenceData(id: ID!): ID! @auth(requires: ADMIN) @tag(name: "admin")
    setReferenceDataActive(id: ID!, active: Boolean!): ReferenceData! @auth(requires: ADMIN) @tag(name: "admin")
}

# ============================================================================
# SECTION 14: MEDIA, STOCK IMAGES, RANKING AND SCHEDULED PUBLICATION (ET-CAT-004)
# ============================================================================

# An image: an organization's upload. Its address is computed from the file store, so it always names
# the store the file is in now.
type MediaAsset {
    id: ID!
    url: String!
    fileName: String!
    contentType: String!
    sizeBytes: Int!
    title: String
    altText: String
    # The event it was uploaded for, if any
    eventId: ID
    organizationId: ID
    uploadedBy: String
    status: MediaStatus!
    # Moderation: why an administrator flagged or removed it. Shown to the owner so they know what to fix.
    flaggedReason: String
    flaggedAt: DateTime
    removedReason: String
    removedAt: DateTime
    # Administrators only; null for anyone else
    moderationLog: [MediaModerationEntry!] @tag(name: "admin")
    createdAt: DateTime
    updatedAt: DateTime
}

type MediaModerationEntry @tag(name: "admin") {
    action: String!
    actorId: String
    reason: String
    at: DateTime
}

type MediaAssetEdge {
    node: MediaAsset!
    cursor: String!
}

type MediaAssetConnection {
    edges: [MediaAssetEdge!]!
    pageInfo: PageInfo!
}

type MediaAssetOffsetPage {
    content: [MediaAsset!]!
    pageNumber: Int!
    pageSize: Int!
    totalElements: Int!
    totalPages: Int!
    hasNext: Boolean!
    hasPrevious: Boolean!
}

# One of the platform's stock images
type StockImage {
    id: ID!
    url: String!
    title: String
    altText: String
    purpose: StockImagePurpose!
    # The category a CATEGORY_TILE stands for
    categoryCode: String
    active: Boolean!
    createdAt: DateTime
    updatedAt: DateTime
}

type StockImageEdge {
    node: StockImage!
    cursor: String!
}

type StockImageConnection {
    edges: [StockImageEdge!]!
    pageInfo: PageInfo!
}

type EventRecommendation {
    event: Event!
    reason: RecommendationReason!
    # For BECAUSE_YOU_BOOKED: the event the buyer already holds that this one resembles
    basedOnEventId: ID
}

# The picture is sent in the request, base64, up to 5 MB. JPEG, PNG or WebP; the bytes are checked,
# not the name.
input UploadMediaInput {
    fileName: String!
    contentType: String!
    contentBase64: String!
    title: String
    altText: String
    eventId: ID
}

input UpdateMediaInput {
    title: String
    altText: String
    eventId: ID
}

input MediaFilterInput {
    eventId: ID
    search: String
}

input MediaModerationFilterInput {
    status: MediaStatus
    organizationId: ID
    eventId: ID
    search: String
}

input UploadStockImageInput {
    fileName: String!
    contentType: String!
    contentBase64: String!
    purpose: StockImagePurpose!
    # Required for CATEGORY_TILE: the reference-data code of the category
    categoryCode: String
    title: String
    altText: String
}

input UpdateStockImageInput {
    title: String
    altText: String
    purpose: StockImagePurpose
    categoryCode: String
    active: Boolean
}

input StockImageFilterInput {
    purpose: StockImagePurpose
    categoryCode: String
    # Administrators only: also the images that are switched off
    includeInactive: Boolean
}

extend type Query {
    # ── Ranking (PUBLIC) ───────────────────────────────────────────────────
    # Upcoming published events ranked by tickets sold.
    trendingEvents(first: Int = 10): [Event!]! @auth(requires: PUBLIC)

    # For a signed-in buyer: events in the categories of the events they hold tickets for, ranked by
    # tickets sold, never an event they already hold. Falls back to trending. The buyer's events are
    # named by the caller (their ticket list is booking's); only their categories are read here.
    recommendedEvents(basedOnEventIds: [ID!], first: Int = 10): [EventRecommendation!]! @auth(requires: CUSTOMER)

    # ── Organizer: own events with a cursor ────────────────────────────────
    # Events of the caller's organizations, newest first, narrowed by the filter.
    myEventsConnection(filter: OrganizerEventFilterInput, pagination: CursorPaginationInput): EventConnection! @auth(requires: ORGANIZER) @tag(name: "organizer")

    # ── Organizer: media library ───────────────────────────────────────────
    myMedia(filter: MediaFilterInput, pagination: CursorPaginationInput): MediaAssetConnection! @auth(requires: ORGANIZER) @tag(name: "organizer")

    # ── Stock images ───────────────────────────────────────────────────────
    stockImages(filter: StockImageFilterInput, pagination: CursorPaginationInput): StockImageConnection! @auth(requires: ORGANIZER) @tag(name: "organizer") @tag(name: "admin")

    # ── Admin: moderation queue over every organization's uploads ──────────
    mediaAssets(filter: MediaModerationFilterInput, pagination: OffsetPaginationInput): MediaAssetOffsetPage! @auth(requires: ADMIN) @tag(name: "admin")
}

extend type Mutation {
    # ── Hidden tiers ───────────────────────────────────────────────────────
    # The hidden tier of a published event that this code opens, or TIER_UNKNOWN for a wrong code
    # (never which part was wrong). Five wrong codes in fifteen minutes stop further tries.
    unlockTierWithAccessCode(eventId: ID!, accessCode: String!): TicketTier! @auth(requires: CUSTOMER)

    # ── Scheduled publication ──────────────────────────────────────────────
    # Stops a scheduled publication: the event stays APPROVED and publishAt is cleared.
    cancelScheduledPublish(eventId: ID!): Event! @auth(requires: ORGANIZER) @tag(name: "organizer")

    # ── Organizer: media library ───────────────────────────────────────────
    uploadMedia(input: UploadMediaInput!): MediaAsset! @auth(requires: ORGANIZER) @tag(name: "organizer")
    updateMedia(id: ID!, input: UpdateMediaInput!): MediaAsset! @auth(requires: ORGANIZER) @tag(name: "organizer")
    deleteMedia(id: ID!): ID! @auth(requires: ORGANIZER) @tag(name: "organizer")

    # ── Admin: moderation ──────────────────────────────────────────────────
    flagMedia(id: ID!, reason: String!): MediaAsset! @auth(requires: ADMIN) @tag(name: "admin")
    removeMedia(id: ID!, reason: String!): MediaAsset! @auth(requires: ADMIN) @tag(name: "admin")
    restoreMedia(id: ID!): MediaAsset! @auth(requires: ADMIN) @tag(name: "admin")

    # Replaces an event's banner with an uploaded or stock image, or clears it (mediaId null).
    # The reason is kept in the audit trail of the image.
    overrideEventBanner(eventId: ID!, mediaId: ID, reason: String!): Event! @auth(requires: ADMIN) @tag(name: "admin")

    # ── Admin: stock library ───────────────────────────────────────────────
    uploadStockImage(input: UploadStockImageInput!): StockImage! @auth(requires: ADMIN) @tag(name: "admin")
    updateStockImage(id: ID!, input: UpdateStockImageInput!): StockImage! @auth(requires: ADMIN) @tag(name: "admin")
    deleteStockImage(id: ID!): ID! @auth(requires: ADMIN) @tag(name: "admin")
}
