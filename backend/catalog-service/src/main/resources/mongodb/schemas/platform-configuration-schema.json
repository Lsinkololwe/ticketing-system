{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Platform Configuration Schema - OWASP Compliant",
    "description": "Single platform-wide configuration document (approval workflow + payment/payout/commission defaults). Singleton keyed by a fixed _id.",
    "required": [
      "_id",
      "approvalSlaHours",
      "payment"
    ],
    "properties": {
      "_id": {
        "bsonType": "string",
        "pattern": "^platform-config$",
        "description": "Fixed singleton identifier - only one configuration document may exist"
      },
      "_class": {
        "bsonType": "string",
        "description": "Spring Data type alias / discriminator"
      },
      "approvalSlaHours": {
        "bsonType": "int",
        "minimum": 1,
        "maximum": 8760,
        "description": "SLA for approval in hours"
      },
      "approvalWarningThresholdHours": {
        "bsonType": "int",
        "minimum": 0,
        "maximum": 8760
      },
      "autoEscalationEnabled": {
        "bsonType": "bool"
      },
      "escalationDelayHours": {
        "bsonType": "int",
        "minimum": 0,
        "maximum": 8760
      },
      "escalationRecipientRole": {
        "bsonType": "string",
        "pattern": "^[A-Z_]{3,50}$",
        "description": "OWASP A03 - role name format"
      },
      "escalationReminderIntervalHours": {
        "bsonType": "int",
        "minimum": 0,
        "maximum": 8760
      },
      "maxEscalationReminders": {
        "bsonType": "int",
        "minimum": 0,
        "maximum": 100
      },
      "organizerNotificationChannel": {
        "bsonType": "string",
        "enum": [
          "EMAIL",
          "IN_APP",
          "BOTH"
        ]
      },
      "adminNotificationChannel": {
        "bsonType": "string",
        "enum": [
          "EMAIL",
          "IN_APP",
          "BOTH"
        ]
      },
      "sendSlaWarningNotifications": {
        "bsonType": "bool"
      },
      "sendEscalationNotifications": {
        "bsonType": "bool"
      },
      "requireCommentsOnRejection": {
        "bsonType": "bool"
      },
      "requireCommentsOnChangesRequested": {
        "bsonType": "bool"
      },
      "allowSelfApproval": {
        "bsonType": "bool"
      },
      "payment": {
        "bsonType": "object",
        "description": "Payment/payout/commission defaults applied to new organizations",
        "required": [
          "commissionRate",
          "payoutMethod",
          "payoutSchedule",
          "minimumPayoutAmount"
        ],
        "properties": {
          "_class": {
            "bsonType": "string",
            "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes \u2014 silently in tests, which use a template with no validator, and totally in production."
          },
          "commissionRate": {
            "bsonType": "double",
            "minimum": 0,
            "maximum": 1,
            "description": "OWASP A04 - default commission rate bounded to [0,1] (0.05 = 5%)"
          },
          "payoutMethod": {
            "bsonType": "string",
            "enum": [
              "BANK_TRANSFER",
              "MOBILE_MONEY",
              "CHEQUE"
            ],
            "description": "OWASP A04 - enum constraint"
          },
          "payoutSchedule": {
            "bsonType": "string",
            "enum": [
              "DAILY",
              "WEEKLY",
              "BIWEEKLY",
              "MONTHLY",
              "MANUAL"
            ],
            "description": "OWASP A04 - enum constraint"
          },
          "minimumPayoutAmount": {
            "bsonType": "double",
            "minimum": 0,
            "description": "Default minimum payout amount in ZMW"
          }
        },
        "additionalProperties": false
      },
      "updatedAt": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "updatedBy": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 100
      }
    },
    "additionalProperties": false
  }
}
