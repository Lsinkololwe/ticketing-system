{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Locations Schema - OWASP Compliant",
    "description": "A simple address/location for an event; the platform does not own or manage venues (com.pml.catalog.domain.model.Location)",
    "required": [
      "isActive"
    ],
    "properties": {
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes — silently in tests, which use a template with no validator, and totally in production."
      },
      "_id": {
        "bsonType": "objectId"
      },
      "name": {
        "bsonType": ["string", "null"],
        "maxLength": 200
      },
      "address": {
        "bsonType": ["string", "null"],
        "maxLength": 500
      },
      "cityId": {
        "bsonType": ["string", "null"],
        "description": "The reference-data CITY code the venue is in"
      },
      "cityName": {
        "bsonType": ["string", "null"]
      },
      "organizationId": {
        "bsonType": ["string", "null"]
      },
      "createdById": {
        "bsonType": ["string", "null"]
      },
      "createdAt": {
        "bsonType": ["date", "null"]
      },
      "provinceName": {
        "bsonType": ["string", "null"]
      },
      "country": {
        "bsonType": ["string", "null"]
      },
      "postalCode": {
        "bsonType": ["string", "null"],
        "maxLength": 20
      },
      "latitude": {
        "bsonType": ["double", "null"],
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "bsonType": ["double", "null"],
        "minimum": -180,
        "maximum": 180
      },
      "description": {
        "bsonType": ["string", "null"],
        "maxLength": 2000
      },
      "isActive": {
        "bsonType": "bool"
      }
    },
    "additionalProperties": false
  }
}
