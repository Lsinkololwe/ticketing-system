{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Event Categories Schema - OWASP Compliant",
    "description": "Categories for organizing and filtering events",
    "required": [
      "name",
      "slug",
      "isActive"
    ],
    "properties": {
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes \u2014 silently in tests, which use a template with no validator, and totally in production."
      },
      "_id": {
        "bsonType": "objectId"
      },
      "name": {
        "bsonType": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "slug": {
        "bsonType": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "OWASP A03 - URL-safe slug format"
      },
      "description": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 500
      },
      "iconUrl": {
        "bsonType": [
          "string",
          "null"
        ],
        "pattern": "^https?://.*",
        "maxLength": 500
      },
      "parentCategoryId": {
        "bsonType": [
          "string",
          "null"
        ],
        "pattern": "^[a-fA-F0-9]{24}$",
        "description": "For hierarchical categories"
      },
      "sortOrder": {
        "bsonType": [
          "int",
          "null"
        ],
        "minimum": 0
      },
      "isActive": {
        "bsonType": "bool"
      },
      "createdAt": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "updatedAt": {
        "bsonType": [
          "date",
          "null"
        ]
      }
    },
    "additionalProperties": false
  }
}
