{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Provinces Schema - OWASP Compliant",
    "description": "Provinces/regions/states",
    "required": [
      "name",
      "country",
      "isActive"
    ],
    "properties": {
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes \u2014 silently in tests, which use a template with no validator, and totally in production."
      },
      "_id": {
        "bsonType": "objectId"
      },
      "name": {
        "bsonType": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "code": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 10,
        "description": "Province code or abbreviation"
      },
      "country": {
        "bsonType": "string",
        "minLength": 2,
        "maxLength": 2,
        "description": "ISO 3166-1 alpha-2 country code (e.g., ZM for Zambia)"
      },
      "isActive": {
        "bsonType": "bool"
      },
      "createdAt": {
        "bsonType": ["date", "null"]
      },
      "updatedAt": {
        "bsonType": ["date", "null"]
      }
    },
    "additionalProperties": false
  }
}
