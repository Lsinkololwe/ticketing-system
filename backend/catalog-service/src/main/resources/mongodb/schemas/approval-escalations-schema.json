{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Approval Escalations Schema - OWASP Compliant",
    "description": "Tracks auto-escalation events when an event approval's SLA is breached (com.pml.catalog.domain.model.ApprovalEscalation)",
    "required": [
      "eventId",
      "status",
      "reason",
      "escalatedTo",
      "triggeredAt"
    ],
    "properties": {
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes — silently in tests, which use a template with no validator, and totally in production."
      },
      "_id": {
        "bsonType": "objectId"
      },
      "eventId": {
        "bsonType": "string",
        "description": "Event this escalation is for"
      },
      "eventTitle": {
        "bsonType": ["string", "null"],
        "description": "Denormalized event title for display"
      },
      "status": {
        "bsonType": "string",
        "enum": ["PENDING", "ACKNOWLEDGED", "RESOLVED", "EXPIRED"],
        "description": "com.pml.catalog.domain.enums.EscalationStatus"
      },
      "reason": {
        "bsonType": "string",
        "maxLength": 1000
      },
      "level": {
        "bsonType": "int",
        "description": "ET-ADM-001 R3 · SLA level: 1/2/3, or 0 for a manually-raised escalation"
      },
      "triggeredAt": {
        "bsonType": "date"
      },
      "acknowledgedAt": {
        "bsonType": ["date", "null"]
      },
      "resolvedAt": {
        "bsonType": ["date", "null"]
      },
      "escalatedTo": {
        "bsonType": "string",
        "description": "User ID of the senior admin this was escalated to"
      },
      "escalatedToName": {
        "bsonType": ["string", "null"]
      },
      "acknowledgedBy": {
        "bsonType": ["string", "null"]
      },
      "acknowledgedByName": {
        "bsonType": ["string", "null"]
      },
      "resolvedBy": {
        "bsonType": ["string", "null"]
      },
      "resolvedByName": {
        "bsonType": ["string", "null"]
      },
      "resolutionNotes": {
        "bsonType": ["string", "null"],
        "maxLength": 2000
      },
      "originalReviewerId": {
        "bsonType": ["string", "null"]
      },
      "originalReviewerName": {
        "bsonType": ["string", "null"]
      },
      "remindersSent": {
        "bsonType": "int"
      },
      "lastReminderAt": {
        "bsonType": ["date", "null"]
      },
      "nextReminderAt": {
        "bsonType": ["date", "null"]
      },
      "hoursOverdue": {
        "bsonType": "int"
      },
      "slaDeadline": {
        "bsonType": ["date", "null"]
      },
      "updatedAt": {
        "bsonType": ["date", "null"]
      }
    },
    "additionalProperties": false
  }
}
