{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Cities Schema - OWASP Compliant",
    "description": "Cities within provinces",
    "required": [
      "name",
      "provinceId",
      "isActive"
    ],
    "properties": {
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes \u2014 silently in tests, which use a template with no validator, and totally in production."
      },
      "_id": {
        "bsonType": "objectId"
      },
      "name": {
        "bsonType": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "provinceId": {
        "bsonType": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "description": "OWASP A03 - ObjectId pattern validation"
      },
      "code": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 10,
        "description": "City code or abbreviation"
      },
      "timezone": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 50,
        "description": "IANA timezone (e.g., Africa/Lusaka)"
      },
      "provinceName": {
        "bsonType": ["string", "null"],
        "description": "Denormalized from Province"
      },
      "country": {
        "bsonType": ["string", "null"],
        "description": "Denormalized from Province.country"
      },
      "eventCount": {
        "bsonType": ["int", "null"],
        "minimum": 0,
        "description": "Denormalized count of events in this city"
      },
      "isActive": {
        "bsonType": "bool"
      },
      "createdAt": {
        "bsonType": ["date", "null"]
      },
      "updatedAt": {
        "bsonType": ["date", "null"]
      }
    },
    "additionalProperties": false
  }
}
