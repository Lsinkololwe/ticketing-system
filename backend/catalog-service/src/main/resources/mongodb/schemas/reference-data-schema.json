{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Reference Data Schema - OWASP Compliant",
    "description": "Polymorphic lookup/catalog rows discriminated by 'type'. One code per type.",
    "required": [
      "type",
      "code",
      "name",
      "isActive",
      "isSystem"
    ],
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "_class": {
        "bsonType": "string",
        "description": "Spring Data type alias / discriminator"
      },
      "type": {
        "bsonType": "string",
        "enum": [
          "COUNTRY",
          "CURRENCY",
          "LANGUAGE",
          "TIMEZONE",
          "PROVINCE",
          "CITY",
          "MOBILE_MONEY_OPERATOR",
          "BANK",
          "EVENT_TYPE",
          "EVENT_CATEGORY",
          "MUSIC_GENRE",
          "AGE_RESTRICTION",
          "REPORT_PERIOD",
          "NOTIFICATION_CATEGORY",
          "NOTIFICATION_CHANNEL",
          "EVENT_ROLE",
          "ORGANIZATION_ROLE",
          "BUSINESS_TYPE",
          "ORGANIZER_TYPE",
          "TICKET_TIER_CATEGORY",
          "KYB_DOCUMENT_TYPE",
          "CANCELLATION_REASON",
          "REFUND_REASON",
          "REJECTION_REASON",
          "TAX_RATE",
          "CARD_SCHEME",
          "TICKET_STATUS",
          "PAYMENT_STATUS",
          "PAYOUT_STATUS",
          "REFUND_STATUS",
          "CHARGEBACK_STATUS",
          "ESCROW_STATUS",
          "EVENT_STATUS",
          "ORGANIZATION_STATUS",
          "VERIFICATION_DOCUMENT_STATUS",
          "TEAM_INVITATION_STATUS",
          "RESERVATION_STATUS"
        ],
        "description": "OWASP A04 - reference type discriminator, bounded to the compiled enum"
      },
      "code": {
        "bsonType": "string",
        "pattern": "^[A-Za-z0-9_./+-]{1,60}$",
        "description": "OWASP A03 - stable business key, unique within type"
      },
      "name": {
        "bsonType": "string",
        "minLength": 1,
        "maxLength": 150
      },
      "description": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 1000
      },
      "parentType": {
        "bsonType": [
          "string",
          "null"
        ],
        "enum": [
          "COUNTRY",
          "CURRENCY",
          "LANGUAGE",
          "TIMEZONE",
          "PROVINCE",
          "CITY",
          "MOBILE_MONEY_OPERATOR",
          "BANK",
          "EVENT_TYPE",
          "EVENT_CATEGORY",
          "MUSIC_GENRE",
          "AGE_RESTRICTION",
          "REPORT_PERIOD",
          "NOTIFICATION_CATEGORY",
          "NOTIFICATION_CHANNEL",
          "EVENT_ROLE",
          "ORGANIZATION_ROLE",
          "BUSINESS_TYPE",
          "ORGANIZER_TYPE",
          "TICKET_TIER_CATEGORY",
          "KYB_DOCUMENT_TYPE",
          "CANCELLATION_REASON",
          "REFUND_REASON",
          "REJECTION_REASON",
          "TAX_RATE",
          "CARD_SCHEME",
          "TICKET_STATUS",
          "PAYMENT_STATUS",
          "PAYOUT_STATUS",
          "REFUND_STATUS",
          "CHARGEBACK_STATUS",
          "ESCROW_STATUS",
          "EVENT_STATUS",
          "ORGANIZATION_STATUS",
          "VERIFICATION_DOCUMENT_STATUS",
          "TEAM_INVITATION_STATUS",
          "RESERVATION_STATUS",
          null
        ]
      },
      "parentCode": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 60
      },
      "displayOrder": {
        "bsonType": "int",
        "minimum": 0,
        "maximum": 100000
      },
      "isActive": {
        "bsonType": "bool"
      },
      "isSystem": {
        "bsonType": "bool"
      },
      "effectiveFrom": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "effectiveTo": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "metadata": {
        "bsonType": [
          "object",
          "null"
        ],
        "description": "Per-type payload, shape enforced at the service layer (ReferenceMetadataValidator)"
      },
      "createdAt": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "updatedAt": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "createdBy": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 100
      },
      "updatedBy": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 100
      },
      "semantic": {
        "bsonType": [
          "string",
          "null"
        ],
        "description": "OWASP A04 - What this value MEANS to the code. Enum-constrained so an administrator cannot invent a meaning no branch handles. Required for workflow types - see the anyOf rule below.",
        "enum": [
          "INITIAL",
          "PENDING",
          "IN_PROGRESS",
          "SUCCEEDED",
          "FAILED",
          "CANCELLED",
          null
        ]
      },
      "allowedTransitions": {
        "bsonType": "array",
        "description": "Codes this value may move to. Empty means unconstrained.",
        "items": {
          "bsonType": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        }
      }
    },
    "additionalProperties": false,
    "anyOf": [
      {
        "description": "Taxonomy types carry no semantic, because nothing branches on them.",
        "properties": {
          "type": {
            "enum": [
              "COUNTRY",
              "CURRENCY",
              "LANGUAGE",
              "TIMEZONE",
              "PROVINCE",
              "CITY",
              "MOBILE_MONEY_OPERATOR",
              "BANK",
              "EVENT_TYPE",
              "EVENT_CATEGORY",
              "MUSIC_GENRE",
              "AGE_RESTRICTION",
              "TICKET_TIER_CATEGORY",
              "ORGANIZER_TYPE",
              "BUSINESS_TYPE",
              "ORGANIZATION_ROLE",
              "EVENT_ROLE",
              "NOTIFICATION_CHANNEL",
              "NOTIFICATION_CATEGORY",
              "REPORT_PERIOD",
              "KYB_DOCUMENT_TYPE",
              "CANCELLATION_REASON",
              "REFUND_REASON",
              "REJECTION_REASON",
              "TAX_RATE",
              "CARD_SCHEME"
            ]
          }
        }
      },
      {
        "description": "A workflow value MUST declare a semantic. Without one a record can reach a status no branch recognises - a payout that never moves, found when an organizer asks where the money went. Expressed here rather than only in Java so it survives a direct mongosh write, a migration script, or any future service.",
        "allOf": [
          {
            "properties": {
              "type": {
                "enum": [
                  "TICKET_STATUS",
                  "PAYMENT_STATUS",
                  "PAYOUT_STATUS",
                  "REFUND_STATUS",
                  "CHARGEBACK_STATUS",
                  "ESCROW_STATUS",
                  "EVENT_STATUS",
                  "ORGANIZATION_STATUS",
                  "VERIFICATION_DOCUMENT_STATUS",
                  "TEAM_INVITATION_STATUS",
                  "RESERVATION_STATUS"
                ]
              }
            }
          },
          {
            "required": [
              "semantic"
            ],
            "properties": {
              "semantic": {
                "bsonType": "string",
                "enum": [
                  "INITIAL",
                  "PENDING",
                  "IN_PROGRESS",
                  "SUCCEEDED",
                  "FAILED",
                  "CANCELLED"
                ]
              }
            }
          }
        ]
      }
    ]
  }
}
