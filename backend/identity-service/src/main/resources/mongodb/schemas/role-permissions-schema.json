{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Role Permissions Schema - OWASP Compliant",
    "description": "Mapping between roles and permissions",
    "required": [
      "roleId",
      "permissionId",
      "isActive",
      "createdAt"
    ],
    "properties": {
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes \u2014 silently in tests, which use a template with no validator, and totally in production."
      },
      "_id": {
        "bsonType": "objectId"
      },
      "roleId": {
        "bsonType": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "description": "OWASP A03 - ObjectId pattern validation"
      },
      "permissionId": {
        "bsonType": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "description": "OWASP A03 - ObjectId pattern validation"
      },
      "createdAt": {
        "bsonType": "date"
      },
      "createdBy": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 100
      },
      "isActive": {
        "bsonType": "bool"
      }
    },
    "additionalProperties": false
  }
}
