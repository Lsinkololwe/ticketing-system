{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Event Access Grants Schema - OWASP Compliant",
    "description": "Grants a user an event-level role that overrides organization-level permissions for that event (com.pml.identity.domain.model.EventAccessGrant)",
    "required": [
      "userId",
      "eventId",
      "organizationId",
      "eventRole",
      "grantedById"
    ],
    "properties": {
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes — silently in tests, which use a template with no validator, and totally in production."
      },
      "_id": {
        "bsonType": "objectId"
      },
      "userId": {
        "bsonType": "string"
      },
      "eventId": {
        "bsonType": "string"
      },
      "organizationId": {
        "bsonType": "string",
        "description": "OWASP A01 - tenant isolation"
      },
      "eventRole": {
        "bsonType": "string",
        "enum": ["EVENT_OWNER", "EVENT_ADMIN", "EDITOR", "CHECK_IN", "VIEWER"],
        "description": "com.pml.identity.domain.valueobject.EventRole"
      },
      "customPermissions": {
        "bsonType": ["array", "null"],
        "items": {
          "bsonType": "string",
          "pattern": "^[a-z_]+:[a-z_]+$",
          "maxLength": 100
        },
        "description": "Permission codes (module:action) added to the event role's"
      },
      "grantedById": {
        "bsonType": "string"
      },
      "reason": {
        "bsonType": ["string", "null"],
        "maxLength": 500
      },
      "status": {
        "bsonType": ["string", "null"],
        "enum": ["ACTIVE", "SUSPENDED", "REVOKED", "EXPIRED", null],
        "description": "com.pml.identity.domain.enums.AccessGrantStatus"
      },
      "expiresAt": {
        "bsonType": ["date", "null"]
      },
      "revokedById": {
        "bsonType": ["string", "null"]
      },
      "revokedAt": {
        "bsonType": ["date", "null"]
      },
      "revocationReason": {
        "bsonType": ["string", "null"],
        "maxLength": 500
      },
      "grantedAt": {
        "bsonType": ["date", "null"]
      },
      "createdAt": {
        "bsonType": ["date", "null"]
      },
      "updatedAt": {
        "bsonType": ["date", "null"]
      }
    },
    "additionalProperties": false
  }
}
