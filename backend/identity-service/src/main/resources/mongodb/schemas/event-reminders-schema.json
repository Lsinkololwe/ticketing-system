{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Event Reminders Schema - OWASP Compliant",
    "description": "User reminders for upcoming events",
    "required": [
      "userId",
      "eventId",
      "reminderDate",
      "status",
      "createdAt"
    ],
    "properties": {
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes \u2014 silently in tests, which use a template with no validator, and totally in production."
      },
      "_id": {
        "bsonType": "objectId"
      },
      "userId": {
        "bsonType": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "description": "OWASP A03 - ObjectId pattern validation"
      },
      "eventId": {
        "bsonType": "string",
        "pattern": "^[a-fA-F0-9]{24}$"
      },
      "reminderDate": {
        "bsonType": "date",
        "description": "When to send the reminder"
      },
      "status": {
        "bsonType": "string",
        "enum": [
          "PENDING",
          "SENT",
          "FAILED",
          "CANCELLED"
        ],
        "description": "OWASP A04 - Enum constraint"
      },
      "sentAt": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "notificationChannel": {
        "bsonType": [
          "string",
          "null"
        ],
        "enum": [
          "EMAIL",
          "SMS",
          "PUSH",
          null
        ]
      },
      "createdAt": {
        "bsonType": "date"
      }
    },
    "additionalProperties": false
  }
}
