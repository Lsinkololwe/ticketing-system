{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Notification Preferences Schema - OWASP Compliant",
    "description": "User preferences for notification channels and types",
    "required": [
      "userId",
      "emailEnabled",
      "smsEnabled",
      "pushEnabled",
      "createdAt"
    ],
    "properties": {
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes \u2014 silently in tests, which use a template with no validator, and totally in production."
      },
      "_id": {
        "bsonType": "objectId"
      },
      "userId": {
        "bsonType": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "description": "OWASP A03 - ObjectId pattern validation"
      },
      "emailEnabled": {
        "bsonType": "bool"
      },
      "smsEnabled": {
        "bsonType": "bool"
      },
      "pushEnabled": {
        "bsonType": "bool"
      },
      "preferences": {
        "bsonType": [
          "object",
          "null"
        ],
        "properties": {
          "ticketPurchase": {
            "bsonType": "bool"
          },
          "eventReminders": {
            "bsonType": "bool"
          },
          "eventCancellations": {
            "bsonType": "bool"
          },
          "refundUpdates": {
            "bsonType": "bool"
          },
          "payoutNotifications": {
            "bsonType": "bool"
          },
          "promotionalEmails": {
            "bsonType": "bool"
          }
        }
      },
      "createdAt": {
        "bsonType": "date"
      },
      "updatedAt": {
        "bsonType": [
          "date",
          "null"
        ]
      }
    },
    "additionalProperties": false
  }
}
