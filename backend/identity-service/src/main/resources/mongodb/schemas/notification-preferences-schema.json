{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Notification Preferences Schema - OWASP Compliant",
    "description": "A user's notification delivery preferences (com.pml.identity.domain.model.NotificationPreferences)",
    "required": [
      "userId"
    ],
    "properties": {
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB's type hint. Written on every document by the mapping converter, so a validator with additionalProperties:false that omits it rejects every write the application makes — silently in tests, which use a template with no validator, and totally in production."
      },
      "_id": {
        "bsonType": "objectId"
      },
      "userId": {
        "bsonType": "string"
      },
      "emailEnabled": {
        "bsonType": ["bool", "null"]
      },
      "smsEnabled": {
        "bsonType": ["bool", "null"]
      },
      "whatsappEnabled": {
        "bsonType": ["bool", "null"]
      },
      "pushEnabled": {
        "bsonType": ["bool", "null"]
      },
      "inAppEnabled": {
        "bsonType": ["bool", "null"]
      },
      "quietHoursStart": {
        "bsonType": ["string", "null"],
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "quietHoursEnd": {
        "bsonType": ["string", "null"],
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "timezone": {
        "bsonType": ["string", "null"],
        "maxLength": 64
      },
      "eventReminders": {
        "bsonType": ["bool", "null"]
      },
      "marketingEmails": {
        "bsonType": ["bool", "null"]
      },
      "reminderHoursBefore": {
        "bsonType": ["int", "null"],
        "minimum": 0
      },
      "createdAt": {
        "bsonType": ["date", "null"]
      },
      "updatedAt": {
        "bsonType": ["date", "null"]
      }
    },
    "additionalProperties": false
  }
}
