{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "Verification Documents Schema - OWASP Compliant",
    "description": "KYB documents uploaded by organizations for verification",
    "required": [
      "organizationId",
      "documentType",
      "documentUrl",
      "status",
      "uploadedAt"
    ],
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "_class": {
        "bsonType": "string",
        "description": "Spring Data MongoDB type discriminator"
      },
      "organizationId": {
        "bsonType": "string",
        "pattern": "^[a-fA-F0-9]{24}$",
        "description": "OWASP A03 - ObjectId pattern validation"
      },
      "documentType": {
        "bsonType": "string",
        "enum": [
          "NATIONAL_ID",
          "TAX_CERTIFICATE",
          "CERTIFICATE_OF_INCORPORATION",
          "PARTNERSHIP_AGREEMENT",
          "NGO_REGISTRATION",
          "AUTHORISATION_LETTER",
          "PROOF_OF_ADDRESS",
          "BANK_STATEMENT",
          "ID_DOCUMENT",
          "BUSINESS_LICENSE",
          "OTHER"
        ],
        "description": "OWASP A04 - Enum constraint. The first eight are the spec ET-ORG-001 §4 vocabulary that RequiredDocuments keys off; a validator that omits them rejects every document the onboarding wizard uploads. ID_DOCUMENT and BUSINESS_LICENSE are the superseded generic names, retained so existing rows stay valid — the generic pair cannot distinguish a certificate of incorporation from an NGO registration, which is a distinction the required-document table depends on."
      },
      "documentUrl": {
        "bsonType": "string",
        "pattern": "^https?://.*",
        "description": "OWASP A03 - URL format validation",
        "maxLength": 1000
      },
      "fileName": {
        "bsonType": ["string", "null"],
        "maxLength": 255
      },
      "fileSize": {
        "bsonType": ["long", "null"],
        "minimum": 0
      },
      "mimeType": {
        "bsonType": ["string", "null"],
        "maxLength": 100
      },
      "status": {
        "bsonType": "string",
        "enum": ["PENDING", "APPROVED", "REJECTED", "EXPIRED"],
        "description": "OWASP A04 - Enum constraint"
      },
      "uploadedAt": {
        "bsonType": "date"
      },
      "verifiedAt": {
        "bsonType": ["date", "null"]
      },
      "verifiedById": {
        "bsonType": ["string", "null"],
        "maxLength": 100
      },
      "rejectionReason": {
        "bsonType": ["string", "null"],
        "maxLength": 500
      }
    },
    "additionalProperties": false
  }
}
