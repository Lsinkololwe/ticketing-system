# ============================================================================
# IDENTITY SERVICE - GraphQL Federation 2 Subgraph Schema
# ============================================================================
#
# This service is the OWNER of User-related entities in our federated graph.
# Other services (Catalog, Booking) can REFERENCE users but cannot modify
# user data directly.
#
# FEDERATION CONCEPTS USED:
# - @key: Marks entities that can be referenced by other services
# - @shareable: Allows other services to also resolve certain fields
# - @external: References fields owned by other services
#
# ============================================================================
# DOMAIN MODEL - ORGANIZATIONAL HIERARCHY
# ============================================================================
#
#   PLATFORM LEVEL (System-wide roles)
#   ===================================
#        SUPER_ADMIN → Full system access
#             │
#        ADMIN → Manage organizers, approve events
#             │
#        FINANCE → Manage payouts, commissions
#
#   ORGANIZATION LEVEL (Tenant-scoped roles)
#   ========================================
#        OWNER → Single person, full org access, can transfer ownership
#             │
#        ADMIN → Full access except ownership transfer
#             │
#    ┌─────────┼─────────┐
#    │         │         │
# MANAGER  MARKETER  CONTRIBUTOR
#    │         │         │
# Events   Analytics   View-only
# Finance  Promotions  Check-in
#
#   EVENT LEVEL (Event-scoped roles - override org roles)
#   =====================================================
#        EVENT_OWNER → Created the event, full control
#             │
#        EVENT_ADMIN → Full access to this event
#             │
#    ┌─────────┼─────────┐
#    │         │         │
# EDITOR   CHECK_IN   VIEWER
#    │         │         │
# Edit     Scan tix   Read-only
# Tickets  at venue
#
# ============================================================================
# KEYCLOAK INTEGRATION ARCHITECTURE
# ============================================================================
#
#   ┌─────────────────────────────────────────────────────────────────────┐
#   │                    KEYCLOAK REALM: event-ticketing                   │
#   ├─────────────────────────────────────────────────────────────────────┤
#   │                                                                     │
#   │   REALM ROLES (Platform-level)                                      │
#   │   ───────────────────────────                                       │
#   │   • SUPER_ADMIN    - Full system access                             │
#   │   • ADMIN          - Platform administration                        │
#   │   • FINANCE        - Financial operations                           │
#   │   • ORGANIZER      - Can create/manage organizations                │
#   │   • CUSTOMER       - Default role for all users                     │
#   │                                                                     │
#   │   GROUPS (Organization mapping)                                     │
#   │   ─────────────────────────────                                     │
#   │   /organizations/{org-slug}           - Organization group          │
#   │   /organizations/{org-slug}/owners    - Organization owners         │
#   │   /organizations/{org-slug}/admins    - Organization admins         │
#   │   /organizations/{org-slug}/managers  - Organization managers       │
#   │   /organizations/{org-slug}/marketers - Organization marketers      │
#   │   /organizations/{org-slug}/members   - Organization contributors   │
#   │                                                                     │
#   │   USER ATTRIBUTES                                                   │
#   │   ───────────────                                                   │
#   │   • mongodb_user_id     - Links to MongoDB User.id                  │
#   │   • phone_number        - Primary phone (E.164 format)              │
#   │   • phone_verified      - Phone verification status                 │
#   │   • primary_org_id      - User's primary organization               │
#   │                                                                     │
#   └─────────────────────────────────────────────────────────────────────┘
#
# ============================================================================
# PROGRESSIVE ONBOARDING FLOW (Industry Standard - Eventbrite/Stripe Connect)
# ============================================================================
#
#   1. USER REGISTRATION (Customer)
#   ───────────────────────────────
#   User signs up via Phone OTP or Email → Creates User in:
#     • Keycloak (with CUSTOMER role)
#     • MongoDB (User document)
#     NOTE: NO Organization created at registration
#
#   2. LAZY ORGANIZATION CREATION
#   ─────────────────────────────
#   When user creates their FIRST EVENT:
#     a) System auto-creates Organization (type: INDIVIDUAL, kyb: NOT_STARTED)
#     b) User becomes OWNER of the organization
#     c) User can create DRAFT events immediately
#
#   3. KYB VERIFICATION (Required for publishing)
#   ─────────────────────────────────────────────
#   Before publishing events or receiving payouts:
#     a) User completes KYB form (business details, documents)
#     b) Admin reviews and verifies (kyb: VERIFIED)
#     c) User can now publish events and receive payouts
#
#   4. UPGRADE TO BUSINESS (Optional)
#   ─────────────────────────────────
#   INDIVIDUAL organizations can upgrade to BUSINESS:
#     a) User provides formal business registration
#     b) System updates organization type to BUSINESS
#     c) User completes business profile and uploads documents
#     d) User submits application → status: PENDING_REVIEW
#
#   3. ADMIN REVIEW & APPROVAL
#   ──────────────────────────
#   Platform admin reviews application:
#     a) Admin calls: mutation { approveOrganization(organizationId: "...") }
#     b) System:
#        - Updates Organization.status → APPROVED
#        - Creates OrganizationMember (OWNER role) for the user
#        - Adds ORGANIZER to User.roles (multi-role support)
#        - Grants ORGANIZER role in Keycloak
#        - Creates Keycloak group: /organizations/{org-slug}
#        - Adds user to /organizations/{org-slug}/owners group
#        - Publishes OrganizerApprovedEvent to Azure Service Bus
#
#   4. ORGANIZATION ACTIVE
#   ──────────────────────
#   Organization owner can now:
#     • Create events (in Catalog Service)
#     • Invite team members
#     • Manage organization settings
#     • Request payouts (in Booking Service)
#
# ============================================================================
# PRE-APPROVAL CAPABILITIES (DRAFT/PENDING Status)
# ============================================================================
#
#   ALLOWED before approval:
#   • Complete organizer profile
#   • Upload verification documents
#   • Create events in DRAFT mode (cannot publish)
#   • Configure ticket types (saved as drafts)
#   • Preview how events will look
#   • View platform tutorials
#
#   NOT ALLOWED before approval:
#   • Publish events (make public)
#   • Accept payments
#   • Invite team members
#   • Request payouts
#   • Access financial reports
#
# ============================================================================
# TEAM INVITATION FLOW
# ============================================================================
#
#   1. Owner/Admin invites member:
#      mutation { inviteTeamMember(input: { email, role, ... }) }
#
#   2. System creates TeamInvitation with unique token
#
#   3. System sends invitation email/SMS with link:
#      https://app.example.com/invitations/accept?token={token}
#
#   4. Invitee clicks link:
#      a) If not registered → Sign up flow with invitation context
#      b) If registered → Accept invitation directly
#
#   5. On acceptance:
#      a) Create OrganizationMember with specified role
#      b) Add user to Keycloak group: /organizations/{org-slug}/{role}
#      c) Publish TeamMemberJoinedEvent
#      d) Notify organization owner
#
# ============================================================================
# OWNERSHIP:
# - User (primary owner)
# - Organization (primary owner - includes application workflow)
# - OrganizationMember (primary owner)
# - TeamInvitation (primary owner)
# - EventAccessGrant (primary owner)
# - Permission, Notification, UserDevice, EventReminder (exclusive)
#
# NOTE: BankAccount and PayoutRequest are owned by Booking Service
#
# ============================================================================
# SCHEMA ORGANIZATION:
# 1. Federation directives & Scalars
# 2. Enums - Platform & Account
# 3. Enums - Organization & Team
# 4. Enums - Notification & Device
# 5. Primary Types - User
# 6. Primary Types - Organization & Team
# 7. Supporting Types - Social Links, Address, etc.
# 8. Notification Types
# 9. Device & Reminder Types
# 10. Permission Types
# 11. Authentication Types
# 12. Statistics Types
# 13. Pagination Types
# 14. Input Types - User & Profile
# 15. Input Types - Organization & Team
# 16. Input Types - Supporting
# 17. Mutation Response Types
# 18. Subscription Payload Types
# 19. Query type (bottom)
# 20. Mutation type (bottom)
# 21. Subscription type (very bottom)
# ============================================================================

# ============================================================================
# SECTION 1: FEDERATION 2 SCHEMA EXTENSION
# ============================================================================
extend schema @link(
    url: "https://specs.apollo.dev/federation/v2.9",
    import: ["@key", "@shareable", "@external", "@requires", "@provides", "@extends", "@inaccessible", "@tag"]
)

# ============================================================================
# AUTHORIZATION DIRECTIVE
# ============================================================================
# Role enum and @auth directive are defined in shared-library/auth.graphqls
# and automatically loaded. Use @auth(requires: ROLE) on operations.
# ============================================================================

# ============================================================================
# CLIENT-SPECIFIC TAGGING STRATEGY
# ============================================================================
# This schema uses @tag directives for operation-based code generation.
# Tags indicate which client types should include specific fields/operations:
#
# - (no tag) = PUBLIC - Available to all clients
# - @tag(name: "mobile") = Mobile app consumer features
# - @tag(name: "organizer") = Organizer dashboard features
# - @tag(name: "admin") = Platform administrator features
# - @tag(name: "internal") = Service-to-service communication only
#
# IDENTITY SERVICE TAGGING PRINCIPLES:
# - User profile (me, myProfile) → mobile
# - User management (list, suspend, etc.) → admin
# - Organizer profile management → organizer
# - Organizer approval workflow → admin
# - Organization management → organizer
# - Platform statistics → admin
# - Keycloak sync → internal
# ============================================================================

# ============================================================================
# SECTION 2: CUSTOM SCALARS
# ============================================================================
scalar DateTime
scalar BigDecimal
scalar JSON
scalar Long
# Phone number as canonical E.164 (e.g. +260971234567). Normalized + validated
# (Google libphonenumber) on input; serialized as E.164 on output.
scalar PhoneNumber

# ============================================================================
# SECTION 3: ENUMS - PLATFORM & ACCOUNT
# ============================================================================

# Platform-level user type (Keycloak realm roles)
# Determines system-wide capabilities
enum UserType {
    CUSTOMER      # Regular customer who buys tickets
    ORGANIZER     # Event organizer who creates and manages events
    ADMIN         # Platform administrator
    SUPER_ADMIN   # Super administrator with full system access
    FINANCE       # Finance team member for payouts and reconciliation
    FINANCE_LEAD  # Receives chargeback and refund escalations; held together with FINANCE
}

# User account status
enum AccountStatus {
    ACTIVE                # Account is active
    INACTIVE              # Account is inactive (user-initiated)
    LOCKED                # Temporarily locked (security)
    SUSPENDED             # Suspended by admin
    PENDING_VERIFICATION  # Awaiting email/phone verification
    PENDING_DELETION      # GDPR deletion requested
}

# Lifecycle of an account (ET-IDN-004, CONTRACT 2)
enum AccountState {
    PROVISIONING   # A contact is claimed; the sign-in identity is not finished
    ACTIVE         # May sign in
    SUSPENDED      # Out of circulation until an administrator lifts it
    MERGED         # Folded into another account
    DELETED        # Removed; contacts released
}

# The kinds of contact an account can hold. A phone contact is a WhatsApp number.
enum ContactType {
    WHATSAPP
    EMAIL
}

# ============================================================================
# SECTION 4: ENUMS - ORGANIZATION & TEAM
# ============================================================================

# Organization status in approval workflow
# APPROVAL-BASED ONBOARDING:
# 1. User applies → DRAFT
# 2. User fills details and submits → PENDING_REVIEW
# 3. Admin: APPROVED / CHANGES_REQUESTED / REJECTED
# 4. User can create draft events during approval process
enum OrganizationStatus {
    # Approval workflow statuses
    DRAFT               # Initial status - application in progress
    PENDING_REVIEW      # Application submitted for admin review
    CHANGES_REQUESTED   # Admin requested changes
    APPROVED            # Application approved - can publish events
    REJECTED            # Application rejected

    # Operational statuses (post-approval)
    ACTIVE              # Organization is active (same as APPROVED)
    SUSPENDED           # Suspended by admin
    INACTIVE            # Deactivated by owner
    PENDING_DELETION    # Deletion requested
}

# Organization type
enum OrganizationType {
    INDIVIDUAL          # Sole proprietor / personal account
    BUSINESS            # For-profit company / commercial promoter
    NON_PROFIT          # NGO, charity or foundation
    GOVERNMENT          # Government / public-sector entity
    EDUCATIONAL         # School, college or university
    COMMUNITY           # Community group, club, association or sports league
    RELIGIOUS           # Church, mosque or faith-based group
}

# Know Your Business (KYB) verification status
# Determines what actions the organization can take
enum KybStatus {
    NOT_STARTED         # KYB not started - can create draft events
    IN_PROGRESS         # KYB form partially filled
    PENDING_REVIEW      # KYB submitted, awaiting admin review
    CHANGES_REQUESTED   # Admin requested changes to KYB
    VERIFIED            # KYB verified - can publish events and receive payouts
    REJECTED            # KYB rejected by admin
}

# Legal business type for KYB verification
enum BusinessType {
    SOLE_PROPRIETORSHIP
    PARTNERSHIP
    LIMITED_COMPANY
    NGO
    GOVERNMENT
    INDIVIDUAL
}

# Payout method
enum PayoutMethod {
    BANK_TRANSFER       # Bank transfer to verified account
    MOBILE_MONEY        # Mobile money (MTN, Airtel, Zamtel)
    CHEQUE              # Cheque payment
}

# Payout schedule
enum PayoutSchedule {
    DAILY
    WEEKLY
    BIWEEKLY
    MONTHLY
    MANUAL              # Manual payouts only
}

# Mobile money providers in Zambia
enum MobileMoneyProvider {
    MTN
    AIRTEL
    ZAMTEL
}

# Organization-level roles (within a tenant)
# These roles determine what a user can do within their organization
enum OrganizationRole {
    # OWNER: Single person who owns the organization
    # - Full access to all organization features
    # - Can transfer ownership to another member
    # - Can delete the organization
    # - Can manage billing and payouts
    # - Only ONE owner per organization
    OWNER

    # ADMIN: Full administrative access
    # - Full access except ownership transfer
    # - Can invite/remove team members
    # - Can manage all events
    # - Can view financial reports
    # - Can request payouts (if enabled by owner)
    ADMIN

    # MANAGER: Event management focus
    # - Can create and manage events
    # - Can publish events
    # - Can view event analytics
    # - Limited financial access (view only)
    # - Cannot invite members
    MANAGER

    # MARKETER: Marketing and analytics focus
    # - Can view all events
    # - Can manage promotions and discounts
    # - Can view analytics and reports
    # - Cannot create or edit events
    # - No financial access
    MARKETER

    # CONTRIBUTOR: Limited access
    # - View-only access to events
    # - Can view attendee lists
    # - Can assist with check-in
    # - No event editing capabilities
    CONTRIBUTOR
}

# Event-level roles (override organization roles for specific events)
enum EventRole {
    # EVENT_OWNER: Person who created the event
    # - Full control over this specific event
    # - Can delete the event
    # - Can assign event roles to others
    EVENT_OWNER

    # EVENT_ADMIN: Full access to this event
    # - Can edit all event details
    # - Can manage tickets and pricing
    # - Can issue refunds
    # - Can assign event roles (except EVENT_OWNER)
    EVENT_ADMIN

    # EDITOR: Can edit event content
    # - Can edit event details (title, description, etc.)
    # - Can manage ticket types
    # - Cannot issue refunds
    # - Cannot assign roles
    EDITOR

    # CHECK_IN: Venue staff for scanning tickets
    # - Can scan/validate tickets
    # - Can view attendee list
    # - Cannot edit anything
    CHECK_IN

    # VIEWER: Read-only access
    # - Can view event details
    # - Can view sales data
    # - Cannot edit or scan
    VIEWER
}

# Team member status within organization
enum MemberStatus {
    ACTIVE              # Active member
    INACTIVE            # Deactivated (by admin)
    SUSPENDED           # Temporarily suspended
    REMOVED             # Removed from organization
}

# Team invitation status
enum InvitationStatus {
    PENDING             # Awaiting response
    ACCEPTED            # Invitation accepted
    DECLINED            # Invitation declined by invitee
    EXPIRED             # Invitation expired
    REVOKED             # Revoked by inviter
}

# Event access grant status
enum AccessGrantStatus {
    ACTIVE              # Access is active
    SUSPENDED           # Access suspended
    REVOKED             # Access revoked
    EXPIRED             # Access expired (time-limited)
}

# ============================================================================
# SECTION 5: ENUMS - NOTIFICATION & DEVICE
# ============================================================================

# Notification types
enum NotificationType {
    # Ticket-related
    TICKET_PURCHASED
    TICKET_TRANSFERRED
    TICKET_TRANSFER_RECEIVED
    TICKET_EXPIRING
    TICKET_REFUND_REQUESTED

    # Payment-related
    PAYMENT_SUCCESSFUL
    PAYMENT_FAILED
    PAYMENT_PENDING

    # Refund-related
    REFUND_REQUESTED
    REFUND_APPROVED
    REFUND_REJECTED
    REFUND_PROCESSED

    # Event-related
    EVENT_REMINDER
    EVENT_CANCELLED
    EVENT_UPDATED
    EVENT_STARTING_SOON
    EVENT_APPROVED
    EVENT_REJECTED
    EVENT_CHANGES_REQUESTED

    # Waitlist/Queue
    WAITLIST_AVAILABLE
    QUEUE_TURN

    # Organizer-related
    ORGANIZER_APPROVED
    ORGANIZER_REJECTED
    ORGANIZER_SUSPENDED
    ORGANIZER_CHANGES_REQUESTED

    # Organization/Team-related
    TEAM_INVITATION_RECEIVED
    TEAM_MEMBER_JOINED
    TEAM_MEMBER_LEFT
    TEAM_ROLE_CHANGED
    OWNERSHIP_TRANSFER_REQUESTED
    OWNERSHIP_TRANSFER_COMPLETED

    # Payout-related
    PAYOUT_REQUESTED
    PAYOUT_APPROVED
    PAYOUT_COMPLETED
    PAYOUT_FAILED

    # System
    SYSTEM_ANNOUNCEMENT
    ACCOUNT_SECURITY
    WELCOME
}

# Notification delivery channels
enum NotificationChannel {
    PUSH        # Mobile push notification
    SMS         # SMS message
    WHATSAPP    # WhatsApp message
    EMAIL       # Email
    IN_APP      # In-app notification
}

# Notification status
enum NotificationStatus {
    PENDING     # Not yet sent
    QUEUED      # Queued for delivery
    SENT        # Sent to delivery provider
    DELIVERED   # Confirmed delivered
    READ        # Read by user
    FAILED      # Delivery failed
    EXPIRED     # Notification expired
    SUPPRESSED  # Not sent: an optional category, channel or quiet hours the recipient chose
}

# Reminder status
enum ReminderStatus {
    SCHEDULED   # Scheduled for future
    SENT        # Reminder sent
    CANCELLED   # Cancelled
    FAILED      # Failed to send
}

# Device platform
enum DevicePlatform {
    IOS         # iOS device
    ANDROID     # Android device
    WEB         # Web browser
}

# Social login provider
enum SocialProvider {
    GOOGLE
    FACEBOOK
    APPLE
    TWITTER
}

# Two-factor authentication method
enum TwoFactorMethod {
    SMS
    EMAIL
    AUTHENTICATOR_APP
    BACKUP_CODE
}

# ============================================================================
# SECTION 6: PRIMARY TYPES - USER
# ============================================================================

# User is the core identity entity, synchronized with Keycloak
# Every person on the platform has exactly ONE User record
# NOTE: User.id IS the Keycloak user ID (no separate keycloakUserId field needed)
# Tags applied at field level to control client access:
# - PUBLIC fields: Basic profile info anyone can see
# - ADMIN fields: User management and audit data
# - ORGANIZER fields: Organizer-related information
type User @key(fields: "id") {
    id: ID!                         # Keycloak user ID (sub claim from JWT)

    # ─────────────────────────────────────────────────────────────────────
    # Core Identity (synced with Keycloak)
    # PUBLIC - Basic profile information
    # ─────────────────────────────────────────────────────────────────────
    # Absent for a buyer account: a buyer is identified by contacts, not by a name or an address
    username: String                # Unique username (Keycloak username; the account id for a buyer)
    # ADMIN - Email is PII, only visible to admins or the user themselves. Staff and legacy accounts only;
    # a buyer's email is a contact (see `contacts`), masked.
    # @shareable allows booking-service to @provides this from cached Ticket data
    email: String @shareable @tag(name: "admin")
    firstName: String
    lastName: String
    # How the person is greeted; optional
    displayName: String
    # @shareable allows booking-service to @provides this from cached Ticket data
    fullName: String! @shareable    # Computed: firstName + lastName
    # ADMIN - Phone number is PII
    # @shareable allows booking-service to @provides this from cached Ticket data
    phoneNumber: PhoneNumber @shareable @tag(name: "admin")
    # ISO-3166 alpha-2 country of phoneNumber (e.g. "ZM")
    phoneCountry: String @tag(name: "admin")

    # ─────────────────────────────────────────────────────────────────────
    # Profile Information
    # PUBLIC - Optional profile details
    # ─────────────────────────────────────────────────────────────────────
    gender: String

    # ─────────────────────────────────────────────────────────────────────
    # Platform Roles & Status
    # ADMIN - User management requires these fields
    # ─────────────────────────────────────────────────────────────────────
    """
    All roles assigned to the user.
    A user can have multiple roles. CUSTOMER is the base role that all users have.
    Example: [CUSTOMER, ORGANIZER] for an event organizer
    """
    roles: [UserType!]! @tag(name: "admin")

    accountStatus: AccountStatus! @tag(name: "admin")

    # Lifecycle of the account (ET-IDN-004). `accountStatus` is the legacy view of the same fact.
    status: AccountState! @tag(name: "admin")

    # The contact the person prefers to be reached on
    preferredChannel: ContactType @tag(name: "mobile")

    # The contacts the account holds, masked. Visible to the account's holder and to administrators.
    contacts: [Contact!]! @tag(name: "mobile")

    # ─────────────────────────────────────────────────────────────────────
    # Verification Status
    # ADMIN - Verification status for user management
    # ─────────────────────────────────────────────────────────────────────
    emailVerified: Boolean! @tag(name: "admin")
    phoneVerified: Boolean! @tag(name: "admin")

    # ─────────────────────────────────────────────────────────────────────
    # Account Flags
    # ADMIN - Account state management
    # ─────────────────────────────────────────────────────────────────────
    active: Boolean! @tag(name: "admin")
    locked: Boolean! @tag(name: "admin")

    # ─────────────────────────────────────────────────────────────────────
    # Two-Factor Authentication
    # MOBILE - User can manage their own 2FA settings
    # ─────────────────────────────────────────────────────────────────────
    twoFactorEnabled: Boolean! @tag(name: "mobile")
    twoFactorMethod: TwoFactorMethod @tag(name: "mobile")

    # ─────────────────────────────────────────────────────────────────────
    # Social Connections
    # MOBILE - User manages their own social connections
    # ─────────────────────────────────────────────────────────────────────
    socialConnections: [SocialConnection!] @tag(name: "mobile")

    # ─────────────────────────────────────────────────────────────────────
    # Organization Memberships
    # ORGANIZER - Organizer dashboard needs organization access
    # ─────────────────────────────────────────────────────────────────────
    organizationMemberships: [OrganizationMember!] @tag(name: "organizer")

    # ─────────────────────────────────────────────────────────────────────
    # Notification Preferences
    # MOBILE - User manages their own notification preferences
    # ─────────────────────────────────────────────────────────────────────
    notificationPreferences: NotificationPreferences @tag(name: "mobile")

    # ─────────────────────────────────────────────────────────────────────
    # Statistics (as customer)
    # PUBLIC - Gamification/profile stats
    # ─────────────────────────────────────────────────────────────────────
    memberSince: DateTime

    # ─────────────────────────────────────────────────────────────────────
    # Audit Fields
    # ADMIN - Audit trail for user management
    # ─────────────────────────────────────────────────────────────────────
    lastLoginAt: DateTime @tag(name: "admin")
    lastActiveAt: DateTime @tag(name: "admin")
    createdAt: DateTime! @tag(name: "admin")
    updatedAt: DateTime @tag(name: "admin")

    # Why an administrator suspended / locked the account. Administrators only; null otherwise.
    suspendReason: String @tag(name: "admin")
    lockReason: String @tag(name: "admin")

    # Set while the person's own deletion request is open; cancelAccountDeletion works until deletionScheduledFor
    deletionRequestedAt: DateTime
    deletionScheduledFor: DateTime
}

# A verified WhatsApp number or email the account owns. Only the masked value is ever exposed
# (for example +260 97* ***123 or j***@gmail.com); the value itself stays encrypted in storage.
type Contact {
    id: ID!
    type: ContactType!
    valueMasked: String!
    verifiedAt: DateTime
    primary: Boolean!
    createdAt: DateTime
}

# ---------------------------------------------------------------------------
# Contact management (ET-IDN-004 R3, R5). Everything acts on the caller's own account.
# Only masked values are ever returned.
# ---------------------------------------------------------------------------

# What a contact change does
enum ContactChangeKind {
    ADD       # a new verified contact joins the account
    CHANGE    # one contact is replaced by another of the same type
    REMOVE    # a contact is released (never the last verified one)
    PRIMARY   # another verified contact becomes the primary one
}

# A code was sent to a contact
type ContactCodeSent {
    challengeId: ID!
    contactType: ContactType!
    # where the code went, masked
    maskedContact: String!
    expiresInSeconds: Int!
    resendAfterSeconds: Int!
}

# A contact change was opened: one code went to the new contact, one to the current primary contact
type ContactChangeRequested {
    changeId: ID!
    newContact: ContactCodeSent!
    currentContact: ContactCodeSent!
    expiresAt: DateTime!
}

# COMPLETED: done, contacts as they now are. APPLYING: verified and finishing in the background;
# ask myContacts again in a moment. Nothing is lost either way.
enum ContactChangeStatus {
    APPLYING
    COMPLETED
}

type ContactChangeResult {
    changeId: ID!
    kind: ContactChangeKind!
    status: ContactChangeStatus!
    contacts: [Contact!]!
}

# A change waiting for its codes (or finishing)
type PendingContactChange {
    changeId: ID!
    kind: ContactChangeKind!
    newContactMasked: String
    expiresAt: DateTime!
    # the code sent to the current primary contact was already accepted
    currentContactVerified: Boolean!
    attemptsRemaining: Int!
}

type MyContacts {
    contacts: [Contact!]!
    pendingChange: PendingContactChange
}

input RequestContactAddInput {
    type: ContactType!
    value: String!
    regionHint: String
}

input ConfirmContactAddInput {
    challengeId: ID!
    code: String!
}

input RequestContactChangeInput {
    contactId: ID!
    type: ContactType!
    value: String!
    regionHint: String
}

input ConfirmContactChangeInput {
    changeId: ID!
    newContactCode: String!
    # required until it has been accepted once
    currentContactCode: String
}

input ConfirmContactRemovalInput {
    challengeId: ID!
    code: String!
}

# Which code of an open change to send again
enum ContactCodeTarget {
    NEW       # the code sent to the contact being added or switched to
    CURRENT   # the code sent to the current primary contact
}

# Name the challenge of an add, removal or primary switch, or the open change with a target
input ResendContactCodeInput {
    challengeId: ID
    changeId: ID
    target: ContactCodeTarget
}

input SetPrimaryContactInput {
    contactId: ID!
    challengeId: ID!
    code: String!
}

# Social login connection
type SocialConnection {
    provider: SocialProvider!
    providerId: String!
    email: String
    name: String
    connectedAt: DateTime!
}

# ============================================================================
# SECTION 7: PRIMARY TYPES - ORGANIZATION & TEAM
# ============================================================================

# Organization represents the business entity (the "tenant")
# APPROVAL-BASED ONBOARDING:
# 1. User applies → Organization created (status=DRAFT)
# 2. User fills business details and submits → PENDING_REVIEW
# 3. Admin approves/rejects → APPROVED/CHANGES_REQUESTED/REJECTED
# 4. User can create DRAFT events during approval process
# ORGANIZER/ADMIN - Organizers manage their organizations, admins oversee all
type Organization @key(fields: "id") @tag(name: "organizer") {
    id: ID!

    # ─────────────────────────────────────────────────────────────────────
    # Basic Information
    # ─────────────────────────────────────────────────────────────────────
    name: String!                   # Display name
    slug: String!                   # URL-friendly identifier (unique)
    description: String
    tagline: String
    logoUrl: String
    bannerUrl: String
    website: String
    socialLinks: SocialLinks

    # ─────────────────────────────────────────────────────────────────────
    # Organization Type & Status
    # ─────────────────────────────────────────────────────────────────────
    type: OrganizationType!         # INDIVIDUAL or BUSINESS
    status: OrganizationStatus!     # Operational status
    kybStatus: KybStatus!           # KYB verification status

    # ─────────────────────────────────────────────────────────────────────
    # Keycloak Integration
    # ─────────────────────────────────────────────────────────────────────
    keycloakGroupId: String         # Keycloak group ID for this org

    # ─────────────────────────────────────────────────────────────────────
    # Ownership
    # ─────────────────────────────────────────────────────────────────────
    ownerId: ID!                    # User ID of the owner
    owner: User                     # Only ONE owner per organization

    # ─────────────────────────────────────────────────────────────────────
    # KYB - Business Information
    # ─────────────────────────────────────────────────────────────────────
    businessType: BusinessType
    taxId: String                   # TPIN in Zambia
    businessRegistrationNumber: String  # PACRA number in Zambia
    yearEstablished: Int

    # ─────────────────────────────────────────────────────────────────────
    # KYB - Contact Information
    # ─────────────────────────────────────────────────────────────────────
    businessPhone: String
    businessEmail: String
    businessAddress: BusinessAddress

    # ─────────────────────────────────────────────────────────────────────
    # Payout Configuration
    # ─────────────────────────────────────────────────────────────────────
    payoutConfig: PayoutConfig

    # ─────────────────────────────────────────────────────────────────────
    # Verification Flags
    # ─────────────────────────────────────────────────────────────────────
    verified: Boolean!              # Business verification status
    documentsVerified: Boolean!     # KYB documents verified
    payoutAccountVerified: Boolean! # Payout account verified
    verifiedAt: DateTime
    verifiedBy: User

    # ─────────────────────────────────────────────────────────────────────
    # Application & Review Information
    # ─────────────────────────────────────────────────────────────────────
    submittedAt: DateTime           # When application was submitted for review
    approvedAt: DateTime            # When application was approved
    rejectionReason: String         # Reason for rejection or changes requested
    reviewedBy: User
    reviewedAt: DateTime
    kybSubmittedAt: DateTime

    # ─────────────────────────────────────────────────────────────────────
    # Commission, suspension and deletion (visible to the organization's members and to administrators)
    # ─────────────────────────────────────────────────────────────────────
    commissionRate: Float           # Percentage this organization is charged (5 = 5%); null until configured
    suspensionReason: String        # Why an administrator suspended it; null when not suspended
    suspendedAt: DateTime
    deletionRequestedAt: DateTime   # Set while a deletion request is open
    deletionScheduledFor: DateTime  # End of the grace period; cancelOrganizationDeletion works until then

    # ─────────────────────────────────────────────────────────────────────
    # Team Members
    # ─────────────────────────────────────────────────────────────────────
    members: [OrganizationMember!]
    memberCount: Int!
    activeMembers: [OrganizationMember!]

    # ─────────────────────────────────────────────────────────────────────
    # Pending Invitations
    # ─────────────────────────────────────────────────────────────────────
    pendingInvitations: [TeamInvitation!]
    pendingInvitationCount: Int!

    # ─────────────────────────────────────────────────────────────────────
    # Verification Documents
    # ─────────────────────────────────────────────────────────────────────
    verificationDocuments: [VerificationDocument!]

    # ─────────────────────────────────────────────────────────────────────
    # Organization Settings
    # ─────────────────────────────────────────────────────────────────────
    settings: OrganizationSettings

    # ─────────────────────────────────────────────────────────────────────
    # Capabilities (derived from status)
    # ─────────────────────────────────────────────────────────────────────
    canCreateDraftEvents: Boolean!  # True for DRAFT, PENDING_REVIEW, CHANGES_REQUESTED, APPROVED
    canPublishEvents: Boolean!      # True only for APPROVED/ACTIVE
    canReceivePayouts: Boolean!     # True only for APPROVED with verified payout account
    canBeEdited: Boolean!           # True for DRAFT, CHANGES_REQUESTED, APPROVED
    canSubmitForReview: Boolean!    # True for DRAFT, CHANGES_REQUESTED
    isApproved: Boolean!            # True for APPROVED/ACTIVE
    isInApprovalWorkflow: Boolean!  # True for DRAFT, PENDING_REVIEW, CHANGES_REQUESTED

    # ─────────────────────────────────────────────────────────────────────
    # Statistics (computed from Catalog/Booking services)
    # ─────────────────────────────────────────────────────────────────────
    totalEvents: Int
    totalTicketsSold: Int
    totalRevenue: BigDecimal
    averageRating: Float

    # ─────────────────────────────────────────────────────────────────────
    # Audit Fields
    # ─────────────────────────────────────────────────────────────────────
    createdAt: DateTime!
    updatedAt: DateTime
}

# Organization member - links User to Organization with a role
# ORGANIZER - Team management for organization owners and admins
type OrganizationMember @tag(name: "organizer") {
    id: ID!

    # ─────────────────────────────────────────────────────────────────────
    # Links
    # ─────────────────────────────────────────────────────────────────────
    userId: ID!
    user: User
    organizationId: ID!
    organization: Organization

    # ─────────────────────────────────────────────────────────────────────
    # Role & Permissions
    # ─────────────────────────────────────────────────────────────────────
    role: OrganizationRole!

    # Custom permissions that override role defaults
    # Example: ["PAYOUT_REQUEST"] grants a Manager payout access
    customPermissions: [String!]

    # Permissions explicitly denied
    # Example: ["EVENT_DELETE"] prevents deletion even for Admins
    deniedPermissions: [String!]

    # ─────────────────────────────────────────────────────────────────────
    # Status
    # ─────────────────────────────────────────────────────────────────────
    status: MemberStatus!

    # ─────────────────────────────────────────────────────────────────────
    # Invitation Tracking
    # ─────────────────────────────────────────────────────────────────────
    invitedById: ID
    invitedBy: User

    # ─────────────────────────────────────────────────────────────────────
    # Timestamps
    # ─────────────────────────────────────────────────────────────────────
    joinedAt: DateTime!
    lastActiveAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime

    # Masked contact details, for the organization's owners and admins (and platform administrators)
    # only; null for everyone else.
    contactEmailMasked: String
    contactPhoneMasked: String
}

# Team invitation for pending members
# ORGANIZER - Team invitation management
"""
What the holder of an invitation link is shown before they accept.

ET-ORG-002 §4 · exactly five fields, and the narrowness is the requirement rather than a
convenience. The invitation token is a bearer credential: it arrives by email or WhatsApp and
is forwarded, screenshotted and pasted into group chats. Everything reachable by it is
reachable by whoever the link reached, so this type answers only what a stranger needs in
order to decide whether to accept — which organization, in what role, from whom, until when.

Deliberately absent: `invitationToken` (the credential itself), `email` and `phoneNumber`
(the invitee's contact details, which a forwarded link would otherwise disclose), `invitedById`,
`message`, and the invitation's own id.
"""
type InvitationPreview {
    organizationName: String!
    organizationLogoUrl: String
    proposedRole: OrganizationRole!
    inviterDisplayName: String!
    expiresAt: DateTime!
}

type TeamInvitation @tag(name: "organizer") {
    id: ID!

    # ─────────────────────────────────────────────────────────────────────
    # Invitee Information
    # ─────────────────────────────────────────────────────────────────────
    email: String                   # Email to send the invitation to; null for a phone invitation
    phoneNumber: String             # WhatsApp number to send the invitation to; null for an email invitation
    inviteeName: String             # Optional name of invitee

    # ─────────────────────────────────────────────────────────────────────
    # Organization
    # ─────────────────────────────────────────────────────────────────────
    organizationId: ID!
    organization: Organization

    # ─────────────────────────────────────────────────────────────────────
    # Proposed Role
    # ─────────────────────────────────────────────────────────────────────
    proposedRole: OrganizationRole!

    # Event-specific access to grant upon acceptance
    eventAccessGrants: [EventAccessProposal!]

    # ─────────────────────────────────────────────────────────────────────
    # Invitation Details
    # ─────────────────────────────────────────────────────────────────────
    invitedById: ID!
    invitedBy: User
    message: String                 # Personal message from inviter

    # ─────────────────────────────────────────────────────────────────────
    # Token & Expiry
    # ─────────────────────────────────────────────────────────────────────
    invitationToken: String!        # Unique token for acceptance link
    expiresAt: DateTime!            # Invitation expiry (default 7 days)

    # ─────────────────────────────────────────────────────────────────────
    # Status
    # ─────────────────────────────────────────────────────────────────────
    status: InvitationStatus!

    # ─────────────────────────────────────────────────────────────────────
    # Timestamps
    # ─────────────────────────────────────────────────────────────────────
    createdAt: DateTime!
    acceptedAt: DateTime
    declinedAt: DateTime
}

# Proposed event access in an invitation (output type)
# Mirrors EventAccessInput but for reading, not writing
# ORGANIZER - Part of team invitation workflow
type EventAccessProposal @tag(name: "organizer") {
    eventId: ID!
    role: EventRole!
    expiresAt: DateTime
}

# Event-level access assignment
# Allows granting specific users access to specific events
# Overrides organization-level role for that event
# ORGANIZER - Event access management for team
type EventAccessGrant @key(fields: "id") @tag(name: "organizer") {
    id: ID!

    # ─────────────────────────────────────────────────────────────────────
    # Links
    # ─────────────────────────────────────────────────────────────────────
    userId: ID!
    user: User
    eventId: ID!                    # References Event in Catalog service
    organizationId: ID!
    organization: Organization

    # ─────────────────────────────────────────────────────────────────────
    # Event Role
    # ─────────────────────────────────────────────────────────────────────
    eventRole: EventRole!

    # Custom permissions for this event
    customPermissions: [String!]

    # ─────────────────────────────────────────────────────────────────────
    # Assignment Details
    # ─────────────────────────────────────────────────────────────────────
    grantedById: ID!
    grantedBy: User
    reason: String                  # Why access was granted

    # ─────────────────────────────────────────────────────────────────────
    # Status & Expiry
    # ─────────────────────────────────────────────────────────────────────
    status: AccessGrantStatus!
    expiresAt: DateTime             # Optional time-limited access

    # ─────────────────────────────────────────────────────────────────────
    # Revocation (if revoked)
    # ─────────────────────────────────────────────────────────────────────
    revokedById: ID
    revokedBy: User
    revokedAt: DateTime
    revocationReason: String

    # ─────────────────────────────────────────────────────────────────────
    # Timestamps
    # ─────────────────────────────────────────────────────────────────────
    grantedAt: DateTime!
    createdAt: DateTime!
    updatedAt: DateTime
}

# Ownership transfer request
type OwnershipTransferRequest {
    id: ID!

    # ─────────────────────────────────────────────────────────────────────
    # Organization
    # ─────────────────────────────────────────────────────────────────────
    organizationId: ID!
    organization: Organization

    # ─────────────────────────────────────────────────────────────────────
    # Transfer Parties
    # ─────────────────────────────────────────────────────────────────────
    currentOwnerId: ID!
    currentOwner: User
    newOwnerId: ID!
    newOwner: User

    # ─────────────────────────────────────────────────────────────────────
    # Transfer Details
    # ─────────────────────────────────────────────────────────────────────
    reason: String

    # F-011 · `transferToken` is deliberately NOT a field here.
    #
    # It is the bearer half of the two-party handshake this spec describes, and it travels to
    # the named recipient by notification. Nothing reads it back: acceptance and decline both
    # take it as an *argument* (see ConfirmOwnershipTransferInput), and the server looks the
    # transfer up by it. A credential only its recipient needs has no reason to be readable
    # through the graph, and exposing it here made it readable by anyone holding a transfer id.

    # ─────────────────────────────────────────────────────────────────────
    # Status
    # ─────────────────────────────────────────────────────────────────────
    status: TransferStatus!
    expiresAt: DateTime!

    # ─────────────────────────────────────────────────────────────────────
    # Timestamps
    # ─────────────────────────────────────────────────────────────────────
    initiatedAt: DateTime!
    completedAt: DateTime
    cancelledAt: DateTime
}

# Ownership transfer status - synchronized with booking service
enum TransferStatus {
    PENDING             # Transfer initiated, waiting for recipient acceptance
    ACCEPTED            # Recipient accepted
    REJECTED            # Recipient rejected the transfer
    COMPLETED           # Transfer completed
    EXPIRED             # Transfer expired after timeout
    CANCELLED           # Transfer cancelled
}

# Organization settings
type OrganizationSettings {
    id: ID!
    organizationId: ID!

    # ─────────────────────────────────────────────────────────────────────
    # Event Defaults
    # ─────────────────────────────────────────────────────────────────────
    defaultEventVisibility: String  # PUBLIC, PRIVATE, UNLISTED
    requireEventApproval: Boolean!  # Events need owner/admin approval

    # ─────────────────────────────────────────────────────────────────────
    # Team Settings
    # ─────────────────────────────────────────────────────────────────────
    allowMembersToInvite: Boolean!  # Can non-owners invite members
    inviteRequiresApproval: Boolean! # Invites need owner approval
    maxTeamMembers: Int             # Max team size (null = unlimited)

    # ─────────────────────────────────────────────────────────────────────
    # Permission Settings
    # ─────────────────────────────────────────────────────────────────────
    managersCanViewFinancials: Boolean!   # Managers see revenue, escrow and commission figures
    adminsCanRequestPayouts: Boolean!     # Admins may request payouts; the owner always may

    # ─────────────────────────────────────────────────────────────────────
    # Notification Settings
    # ─────────────────────────────────────────────────────────────────────
    notifyOwnerOnMemberJoin: Boolean!
    notifyOwnerOnEventCreated: Boolean!
    notifyOwnerOnPayoutRequest: Boolean!

    # ─────────────────────────────────────────────────────────────────────
    # Audit
    # ─────────────────────────────────────────────────────────────────────
    updatedAt: DateTime
    updatedById: ID
}

# ============================================================================
# SECTION 8: SUPPORTING TYPES - SOCIAL LINKS & ADDRESS
# ============================================================================

type SocialLinks {
    facebook: String
    twitter: String
    instagram: String
    linkedin: String
    youtube: String
    tiktok: String
}

# Business address for an organization
type BusinessAddress {
    addressLine1: String
    addressLine2: String
    city: String
    province: String                # Province/State
    postalCode: String
    country: String
    countryCode: String             # ISO 3166-1 alpha-2 (e.g., ZM for Zambia)
    formattedAddress: String        # Computed full address string
}

# Bank account details for payout configuration (embedded type)
# NOTE: Full BankAccount entity is owned by Booking Service
type PayoutBankDetails {
    bankName: String
    bankCode: String                # SWIFT code
    branchName: String
    branchCode: String
    accountNumber: String           # Masked for display
    maskedAccountNumber: String     # Last 4 digits only
    accountHolderName: String
    accountType: String             # CHECKING, SAVINGS, BUSINESS
    verified: Boolean!
    status: PayoutAccountStatus!
    rejectionReason: String
    suspended: Boolean!
    suspendedReason: String
    testDepositSentAt: DateTime
    verificationAttemptsLeft: Int!
}

# Mobile money account for payouts (Zambia: MTN, Airtel, Zamtel)
type MobileMoneyAccount {
    provider: MobileMoneyProvider
    phoneNumber: String             # Masked for display
    maskedPhoneNumber: String       # +260****1234
    accountHolderName: String
    verified: Boolean!
    status: PayoutAccountStatus!
    rejectionReason: String
    suspended: Boolean!
    suspendedReason: String
    testDepositSentAt: DateTime
    verificationAttemptsLeft: Int!
}

# ============================================================================
# PLATFORM RULES (readable by any signed-in caller; no personal data)
# ============================================================================
# The values organizers and buyers must obey. Administrators edit them through catalog's
# updatePlatformConfiguration; this is the read side for everyone else. Commission figures are
# percentages (5 = 5%). Reference lists (banks, categories, cities, cancellation reasons, KYB
# document types) are catalog reference data: use catalog's `referenceData(type:)`.
type PlatformRules {
    version: Int!                       # Bumped on every save; compare it to show a 'New' chip
    updatedAt: DateTime
    updatedBy: String                   # Display name of the administrator
    currency: String!
    commissionDefault: Float!           # Platform default, percent
    commissionRate: Float               # What applies to the caller's organization (its own, else the default)
    minimumPayout: BigDecimal
    reservationHoldMinutes: Int!
    reservationGraceMinutes: Int!
    escrowHoldDays: Int!
    refundCutoffHours: Int!
    maxTicketsPerBooking: Int!
    rescheduleLimit: Int!
    refundPolicies: [RulesRefundPolicy!]!
    approval: PlatformRulesApproval!
}

# The signed-out subset of PlatformRules (ET-ADM-002-R10): what a buyer needs before signing in.
# Readable WITHOUT a token, rate limited per client address. Nothing about commission, payouts,
# escrow, approval or administrators; use `platformRules` (signed in) for those.
type PublicPlatformRules {
    version: Int!
    updatedAt: DateTime
    currency: String!
    reservationHoldMinutes: Int!
    reservationGraceMinutes: Int!
    maxTicketsPerBooking: Int!
    refundCutoffHours: Int!
    rescheduleLimit: Int!
    refundPolicies: [RulesRefundPolicy!]!
}

type RulesRefundPolicy {
    code: String!                       # FLEXIBLE | MODERATE | STRICT | NO_REFUNDS
    label: String!
    summary: String!
    rules: [RulesRefundTier!]!
}

type RulesRefundTier {
    daysBefore: Int!
    percent: Int!
}

type PlatformRulesApproval {
    slaHours: Int!
    warnHours: Int!
    autoEscalation: Boolean!
    escalationDelayHours: Int!
    requireCommentsOnRejection: Boolean!
    requireCommentsOnChangesRequested: Boolean!
    allowSelfApproval: Boolean!
}

# ============================================================================
# PLATFORM OPERATIONS: health, alerts, announcements
# ============================================================================
enum ServiceStatus {
    UP
    DOWN
}

type ServiceHealth @tag(name: "admin") {
    name: String!                   # mongodb | redis | keycloak | a configured downstream service
    status: ServiceStatus!
    latencyMillis: Long!
    checkedAt: DateTime!
    detail: String                  # A category such as "timeout"; never an address
}

enum AlertSeverity {
    INFO
    WARNING
    CRITICAL
}

enum AlertStatus {
    OPEN
    ACKNOWLEDGED
    RESOLVED
}

type SystemAlert @tag(name: "admin") {
    id: ID!
    source: String!
    key: String!
    severity: AlertSeverity!
    title: String!
    message: String
    status: AlertStatus!
    occurrences: Int!               # How many times the condition was reported while open
    raisedAt: DateTime!
    lastSeenAt: DateTime
    acknowledgedAt: DateTime
    acknowledgedBy: ID
    resolvedAt: DateTime
}

enum AnnouncementSegment {
    ALL
    ORGANIZERS
    BUYERS
    STAFF
}

type SystemAnnouncement {
    id: ID!
    title: String!
    message: String!
    segment: AnnouncementSegment!
    severity: AlertSeverity!
    startsAt: DateTime!             # A future time means it is scheduled
    endsAt: DateTime
    cancelledAt: DateTime
    createdAt: DateTime!
}

input BroadcastInput {
    title: String!
    message: String!
    segment: AnnouncementSegment = ALL
    severity: AlertSeverity = INFO
    startsAt: DateTime              # Omit to publish now
    endsAt: DateTime
}

# One live login session of the caller
type AccountSession {
    id: ID!
    ipAddress: String
    startedAt: DateTime
    lastAccessAt: DateTime
    clients: [String!]!
    current: Boolean!               # The session making this request
}

enum GrowthBucket {
    DAY
    WEEK                            # weeks start on Monday
    MONTH
}

type GrowthPoint @tag(name: "admin") {
    bucketStart: DateTime!          # Start of the bucket in the platform's time zone (Africa/Lusaka)
    newUsers: Int!
    cumulative: Int!
}

input AuditLogFilterInput {
    from: DateTime
    to: DateTime
    action: String
    actorId: ID
    resourceType: String
    resourceId: ID
    status: String
    # Also list account events (OTP locks, merges ...) that are not audit rows
    includeAccountEvents: Boolean
}

type AuditLogEntry @tag(name: "admin") {
    id: ID!
    source: String!                 # AUDIT | ACCOUNT_EVENT
    action: String!
    actorId: ID
    subjectId: ID
    resourceType: String
    resourceId: ID
    status: String
    at: DateTime
    metadata: JSON
}

type AuditLogEntryOffsetPage @tag(name: "admin") {
    content: [AuditLogEntry!]!
    pageInfo: PageInfo!
}

# Where a payout account is in review
enum PayoutAccountStatus {
    NONE
    PENDING
    VERIFIED
    REJECTED
    SUSPENDED
}

# One organization's payout account as the admin review table shows it (numbers masked)
type PayoutAccountRecord @tag(name: "admin") {
    organizationId: ID!
    organizationName: String!
    organizationSlug: String!
    method: PayoutMethod!
    status: PayoutAccountStatus!
    bankName: String
    accountNumberMasked: String
    accountHolderName: String
    network: MobileMoneyProvider
    phoneMasked: String
    rejectionReason: String
    suspendedReason: String
    testDepositSentAt: DateTime
    verificationAttemptsLeft: Int!
    updatedAt: DateTime
}

type PayoutAccountRecordOffsetPage @tag(name: "admin") {
    content: [PayoutAccountRecord!]!
    pageInfo: PageInfo!
}

input PayoutAccountFilterInput {
    status: PayoutAccountStatus
    method: PayoutMethod
    search: String
}

# Payout configuration for an organization
type PayoutConfig {
    preferredMethod: PayoutMethod
    schedule: PayoutSchedule
    commissionRate: Float           # Platform commission (e.g., 0.05 = 5%)
    minimumPayoutAmount: Float      # Minimum payout in ZMW
    bankAccount: PayoutBankDetails
    mobileMoneyAccount: MobileMoneyAccount
    verified: Boolean!              # Payout config verified
    isConfigured: Boolean!          # Has a configured payout method
    canProcessPayouts: Boolean!     # Ready to process payouts
}

type VerificationDocument {
    id: ID!
    documentType: String!           # ID_DOCUMENT, BUSINESS_LICENSE, TAX_CERT, etc.
    documentUrl: String!
    fileName: String
    fileSize: Int
    mimeType: String
    status: DocumentStatus!
    uploadedAt: DateTime!
    verifiedAt: DateTime
    verifiedById: String
    verifiedBy: User
    rejectionReason: String
}

enum DocumentStatus {
    PENDING             # Uploaded, awaiting review
    APPROVED            # Document verified
    REJECTED            # Document rejected
    EXPIRED             # Document has expired
}

# ============================================================================
# SECTION 9: NOTIFICATION TYPES
# ============================================================================

type Notification {
    id: ID!
    userId: ID!

    # Content
    type: NotificationType!
    title: String!
    body: String!
    imageUrl: String
    actionUrl: String
    data: JSON

    # Delivery
    channels: [NotificationChannel!]!
    priority: String

    # Status tracking per channel
    channelStatuses: [ChannelStatus!]
    status: NotificationStatus!

    # Timestamps
    scheduledAt: DateTime
    sentAt: DateTime
    deliveredAt: DateTime
    readAt: DateTime
    expiresAt: DateTime

    # Audit
    createdAt: DateTime!
}

type ChannelStatus {
    channel: NotificationChannel!
    status: NotificationStatus!
    sentAt: DateTime
    deliveredAt: DateTime
    errorMessage: String
}

type NotificationPreferences {
    id: ID!
    userId: ID!

    # Channel preferences
    emailEnabled: Boolean!
    smsEnabled: Boolean!
    whatsappEnabled: Boolean!
    pushEnabled: Boolean!
    inAppEnabled: Boolean!

    # Category preferences
    ticketNotifications: Boolean!
    eventReminders: Boolean!
    eventUpdates: Boolean!
    paymentNotifications: Boolean!
    teamNotifications: Boolean!
    marketingEmails: Boolean!
    systemAnnouncements: Boolean!

    # Timing preferences
    reminderHoursBefore: Int!
    quietHoursStart: String
    quietHoursEnd: String
    timezone: String

    # Audit
    updatedAt: DateTime
}

# ============================================================================
# SECTION 10: DEVICE & REMINDER TYPES
# ============================================================================

type UserDevice {
    id: ID!
    userId: ID!

    # Device info
    deviceToken: String!
    platform: DevicePlatform!
    deviceName: String
    deviceModel: String
    osVersion: String
    appVersion: String

    # Status
    isActive: Boolean!
    isPrimary: Boolean!

    # Timestamps
    lastActiveAt: DateTime
    createdAt: DateTime!
    updatedAt: DateTime
}

type EventReminder {
    id: ID!
    userId: ID!
    eventId: ID!
    ticketId: ID!

    # Reminder details
    eventTitle: String
    eventDateTime: DateTime
    reminderAt: DateTime!

    # Delivery
    channels: [NotificationChannel!]

    # Status
    status: ReminderStatus!
    sentAt: DateTime
    errorMessage: String

    # Audit
    createdAt: DateTime!
    updatedAt: DateTime
}

# ============================================================================
# SECTION 11: PERMISSION TYPES
# ============================================================================

# A permission from the platform's catalogue. The catalogue is fixed in software and changes only
# with a release; there is nothing to create, edit or delete.
type Permission {
    code: String!                   # module:action, e.g. event:create
    module: String!                 # the part before the colon, e.g. event
    description: String!
    scope: PermissionScope!         # where the permission is held
}

enum PermissionScope {
    PLATFORM            # held through a platform role
    ORGANIZATION        # held through organization membership
    EVENT               # held on one event, through membership or an event access grant
}

# A role and the permissions it carries.
type RolePermissions {
    role: String!                   # e.g. MANAGER, EVENT_ADMIN, FINANCE
    scope: PermissionScope!
    permissions: [Permission!]!     # carried in every organization
    switchable: [Permission!]!      # carried only where the organization's owner has switched it on
}

# What a user may do in a context, and which step decided it: PLATFORM, EVENT, ORGANIZATION or NONE.
type EffectivePermissions {
    userId: ID!
    organizationId: ID
    eventId: ID
    permissions: [String!]!         # permission codes
    role: String                    # the event role when a grant decided, else the organization role
    source: String
}

# What the signed-in user's platform roles allow, before any organization or event is involved.
type MyPermissions {
    roles: [String!]!
    permissions: [String!]!         # permission codes
}

# ============================================================================
# SECTION 12: AUTHENTICATION TYPES
# ============================================================================
# None. Keycloak signs people in; the password, registration, refresh and validation
# payloads were removed with their mutations (ET-IDN-004).

# ============================================================================
# SECTION 13: STATISTICS TYPES
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# USER STATISTICS (Admin Dashboard)
# ─────────────────────────────────────────────────────────────────────────────
# Comprehensive user statistics for admin dashboard.
# Uses MongoDB aggregation pipelines for efficient computation.

# ADMIN - Main container for user statistics
type UserStats @tag(name: "admin") {
    # Core counts
    totalUsers: Int!
    organizers: Int!
    attendees: Int!
    adminUsers: Int!
    verifiedUsers: Int!
    activeUsers: Int!

    # Account status counts
    suspendedUsers: Int!
    lockedUsers: Int!
    pendingVerificationUsers: Int!

    # Time-based counts
    newUsersThisMonth: Int!
    newUsersThisWeek: Int!

    # Growth metric (month-over-month percentage)
    growthRate: Float

    # Breakdowns
    usersByRole: [UserRoleStats!]!
    usersByStatus: [UserStatusStats!]!
}

# ADMIN - Identity-owned pending approval-queue counts (action-center badges).
# Counts are computed with MongoDB aggregation (PendingApprovalStatsService).
type IdentityPendingCounts @tag(name: "admin") {
    # Organizations awaiting admin review (status = PENDING_REVIEW)
    organizerApplications: Int!
    # Verification documents awaiting review (status = PENDING)
    documentVerifications: Int!
}

# ADMIN - Statistics for users grouped by role
# Note: Since users can have multiple roles, the total count across all
# roles may exceed the total number of users (one user counted per role)
type UserRoleStats @tag(name: "admin") {
    role: UserType!
    count: Int!
    percentage: Float!
}

# ADMIN - Statistics for users grouped by account status
type UserStatusStats @tag(name: "admin") {
    status: AccountStatus!
    count: Int!
    percentage: Float!
}

# ============================================================================
# SECTION 14: PAGINATION TYPES
# ============================================================================

# Offset-based pagination input for admin/dashboard tables
input OffsetPaginationInput {
    page: Int = 0
    size: Int = 20
    sortBy: String = "createdAt"
    sortDirection: SortDirection = DESC
}

# Cursor-based pagination input (Relay style) for mobile/infinite scroll
input CursorPaginationInput {
    first: Int
    after: String
    last: Int
    before: String
}

enum SortDirection {
    ASC
    DESC
}

# Shared type for cursor-based pagination - must have @shareable for federation
type PageInfo @shareable {
    hasNextPage: Boolean @shareable
    hasPreviousPage: Boolean @shareable
    startCursor: String @shareable
    endCursor: String @shareable
    totalCount: Int @shareable
    totalElements: Int @shareable
    totalPages: Int @shareable
    currentPage: Int @shareable
    pageSize: Int @shareable
    hasNext: Boolean @shareable
    hasPrevious: Boolean @shareable
}

# Paged results
type UserOffsetPage {
    content: [User!]!
    pageInfo: PageInfo!
}

type OrganizationOffsetPage {
    content: [Organization!]!
    pageInfo: PageInfo!
}

type OrganizationMemberOffsetPage {
    content: [OrganizationMember!]!
    pageInfo: PageInfo!
}

# Organization Application Pagination (Approval Queue)
type OrganizationApplicationOffsetPage {
    content: [Organization!]!
    pageInfo: PageInfo!
}

type NotificationOffsetPage {
    content: [Notification!]!
    pageInfo: PageInfo!
}

type TeamInvitationOffsetPage {
    content: [TeamInvitation!]!
    pageInfo: PageInfo!
}

type EventAccessGrantOffsetPage {
    content: [EventAccessGrant!]!
    pageInfo: PageInfo!
}

# ============================================================================
# SECTION 14b: CURSOR PAGINATION TYPES (Relay-style Connections)
# ============================================================================
# Cursor-based pagination following the Relay Connection Specification.
# Used for infinite scroll, mobile apps, and real-time feeds.
# https://relay.dev/graphql/connections.htm

# Notification cursor pagination
type NotificationConnection {
    edges: [NotificationEdge!]!
    pageInfo: PageInfo!
    totalCount: Int
}

type NotificationEdge {
    cursor: String!
    node: Notification!
}

