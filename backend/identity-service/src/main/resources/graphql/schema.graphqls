    firstName: String!
    lastName: String!
    password: String
    # Mobile number of the staff member (normalised; a number that does not parse refuses the call)
    phoneNumber: String
    # Granted on top of the base CUSTOMER role; omit for a plain account
    role: UserType
}

input UpdateUserInput {
    firstName: String
    lastName: String
    displayName: String
    gender: String
}

input UpdateNotificationPreferencesInput {
    emailEnabled: Boolean
    smsEnabled: Boolean
    whatsappEnabled: Boolean
    pushEnabled: Boolean
    inAppEnabled: Boolean
    ticketNotifications: Boolean
    eventReminders: Boolean
    eventUpdates: Boolean
    paymentNotifications: Boolean
    teamNotifications: Boolean
    marketingEmails: Boolean
    systemAnnouncements: Boolean
    reminderHoursBefore: Int
    quietHoursStart: String
    quietHoursEnd: String
    timezone: String
}

# ============================================================================
# SECTION 16: INPUT TYPES - SUPPORTING
# ============================================================================

input SocialLinksInput {
    facebook: String
    twitter: String
    instagram: String
    linkedin: String
    youtube: String
    tiktok: String
}

# File upload input for verification documents
# NOTE: For GraphQL file uploads, clients should use multipart/form-data
# with the GraphQL multipart request specification
input UploadVerificationDocumentInput {
    documentType: String!           # ID_DOCUMENT, BUSINESS_LICENSE, TAX_CERTIFICATE, etc.
    # For multipart uploads, file is sent separately in the multipart request
    # For URL-based uploads (after client-side S3 upload), provide these:
    documentUrl: String             # Pre-uploaded file URL (optional if using multipart)
    fileName: String!               # Original filename (required for validation)
    fileSize: Long!                 # File size in bytes (required for validation)
    mimeType: String!               # MIME type (required for validation)
}

# Request presigned URL for client-side upload
input RequestUploadUrlInput {
    documentType: String!
    fileName: String!
    fileSize: Long!
    mimeType: String!
}

# Response for upload URL request
type DocumentUploadUrlResponse {
    uploadUrl: String!              # Presigned URL for PUT request
    fileKey: String!                # Storage key to reference after upload
    expiresAt: DateTime!            # URL expiration timestamp
    maxFileSize: Long!              # Maximum allowed file size
    allowedMimeTypes: [String!]!    # Allowed MIME types
}

# Response for document upload
# File upload validation error
type FileUploadError {
    field: String!
    message: String!
    code: FileUploadErrorCode!
}

# Error codes for file upload validation
enum FileUploadErrorCode {
    FILE_TOO_LARGE
    INVALID_FILE_TYPE
    INVALID_MIME_TYPE
    INVALID_FILENAME
    CORRUPTED_FILE
    MALWARE_DETECTED
    UPLOAD_FAILED
    VALIDATION_FAILED
}

