<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pml</groupId>
        <artifactId>backend</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>identity-service</artifactId>
    <name>Identity and Platform Service</name>
    <description>User Management and Platform Operations Microservice</description>

    <properties>
        <!-- Ahead of the version Spring Boot 3.5.4 manages (1.21.3), which pins the Docker
             API to 1.32 and is refused by Docker Engine 29 (minimum API 1.40). -->
    </properties>

    <dependencies>
        <!-- Shared Library -->
        <dependency>
            <groupId>com.pml</groupId>
            <artifactId>shared-library</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb-reactive</artifactId>
        </dependency>
        <!-- Netflix DGS Framework with Spring GraphQL integration and Apollo Federation -->
        <dependency>
            <groupId>com.netflix.graphql.dgs</groupId>
            <artifactId>graphql-dgs-spring-graphql-starter</artifactId>
        </dependency>
        <!-- DGS Extended Scalars (DateTime, BigDecimal, JSON) -->
        <dependency>
            <groupId>com.netflix.graphql.dgs</groupId>
            <artifactId>graphql-dgs-extended-scalars</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jackson for JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- JWT Support -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Monitoring and Observability -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- AWS SDK for S3 File Storage -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            spring-boot-starter-test does not bring this in transitively on this Boot version, so
            Surefire falls back to its own bundled JUnit Platform launcher instead of the project's
            (junit-bom-managed) one. That fallback silently never runs a single @Nested test class —
            no error, no "skipped" count, "Tests run" just reports the top-level methods only. Found
            2026-10-10: TicketTierTenantBoundaryTest's whole Outsider/Owner attack scenario had never
            executed. Declaring the launcher explicitly is this fix.
        -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            ET-PLT-001 R7 · the JWT rejection contract.

            StubIssuer and JwtRejectionContract live in shared-library's test-jar so that the
            four checks are asserted identically here, in booking and in identity. Three
            copies of four assertions is how one of them quietly ends up checking three.
        -->
        <dependency>
            <groupId>com.pml</groupId>
            <artifactId>shared-library</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Flow B integration tests: real Keycloak with the production realm,
             themes and the keycloak-extensions SPI jar -->
        <dependency>
            <groupId>com.github.dasniko</groupId>
            <artifactId>testcontainers-keycloak</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Flow B integration tests: observable binding for StreamBridge.
             Substitutes the Azure Service Bus wire protocol ONLY; binding name,
             destination and payload serialization are still exercised. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-stream-test-binder</artifactId>
            
            <scope>test</scope>
        </dependency>

        <!-- Password Encoding -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- OAuth2 Client for token delegation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!-- OAuth2 Resource Server for JWT validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Keycloak Admin Client for user management via Admin API -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-admin-client</artifactId>
            <version>${keycloak-admin-client.version}</version>
            <exclusions>
                <!-- 26.0.12 declares Jackson 2.21; the platform runs Boot's 2.19 (see root pom) -->
                <exclusion><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId></exclusion>
                <exclusion><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jdk8</artifactId></exclusion>
                <exclusion><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId></exclusion>
                <exclusion><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-annotations</artifactId></exclusion>
                <exclusion><groupId>com.fasterxml.jackson.jakarta.rs</groupId><artifactId>jackson-jakarta-rs-yaml-provider</artifactId></exclusion>
            </exclusions>
        </dependency>

        <!-- Redis for OTP storage and caching -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>

        <!-- Azure Service Bus for cross-service events -->
        <dependency>
            <groupId>com.azure.spring</groupId>
            <artifactId>spring-cloud-azure-stream-binder-servicebus</artifactId>
        </dependency>

        <!-- Spring Boot DevTools for automatic restart during development -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Resilience4j for circuit breaker and retry patterns -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- ET-PLT-015 · durable execution: workflow client, worker factory, auto-discovery -->
        <dependency>
            <groupId>io.temporal</groupId>
            <artifactId>temporal-spring-boot-starter</artifactId>
            <!-- The in-process test server belongs on the test classpath only; it is declared
                 below at test scope, and the starter's auto-configuration is conditional on it. -->
            <exclusions>
                <exclusion>
                    <groupId>io.temporal</groupId>
                    <artifactId>temporal-testing</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- ET-PLT-006 layer 3 · time-skipping TestWorkflowEnvironment -->
        <dependency>
            <groupId>io.temporal</groupId>
            <artifactId>temporal-testing</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Pin the Docker API version the Testcontainers client
                        negotiates. Without this, docker-java falls back to 1.32,
                        which Docker Engine 23+ rejects outright (minimum 1.40).
                        The failure surfaces as "Could not find a valid Docker
                        environment", which reads like Docker is not running and
                        sends you looking in the wrong place.

                        1.44 is Engine 25.0 (Jan 2024) and is accepted by every
                        engine since 19.03. Override with -Ddocker.api.version=
                        if a newer feature is ever needed.
                    -->
                    <argLine>@{argLine} -Dapi.version=${docker.api.version}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Container-backed integration tests (*IT) run in `verify`, not `test`,
                 so `mvn test` stays fast and Docker-free. -->
            <!--
                ET-PLT-005 · the maven-failsafe-plugin binding was removed on 2026-09-02.

                It included `**/*IT.java` and there is not one such file anywhere in the backend —
                this corpus names its layer-5 tests `*Test` and groups them by `@Tag`, running them
                under surefire. identity-service was also the only one of five modules to bind it.

                Dead configuration would be merely untidy; this was not. Every spec's stated verify
                command is `mvn -f backend verify -Dgroups=<SPEC> -DfailIfNoTests=true`, and
                failsafe reads that same flag — so it failed with "No tests were executed!" on
                identity-service for EVERY spec, always, regardless of how much passed. The one
                command the corpus uses to decide a spec is done could not succeed. See F-022.

                If `*IT` naming is ever adopted, add failsafe to the PARENT so all five modules get
                it, rather than to one.
            -->
        </plugins>
    </build>
</project>
